{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "insight-turso-ingest-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/15 * * * *", "3,18,33,48 * * * *"],
  },
  "vars": {
    "INSIGHT_INGEST_URL": "https://www.oracleinsight.xyz/api/cron/turso-ingest",
    "INSIGHT_PROJECT_URL": "https://www.oracleinsight.xyz/api/cron/turso-project",
  },
  "secrets": {
    "required": ["INGEST_SCHEDULER_SECRET"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
}
