# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# ML training venv (local only; GitHub Actions installs fresh)
ml/.venv/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase
supabase/.temp/
supabase/backups/

# IDE working dirs
.trae/

# AI agent working memory (local only — never commit)
.workbuddy-ai/
.workbuddy/

# VRT1 prototype run artifacts — regenerated by builders/prototype.mjs on every run.
# The anchored evidence files (evidence/registry-genesis.json, evidence/vvv-vrt1-record.json)
# are tracked on purpose; these two are not evidence.
scripts/vrt1-e2e-prototype/builders/vrt1-action.json
scripts/vrt1-e2e-prototype/builders/anchor-epoch.json
