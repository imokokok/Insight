{
  "name": "oracle-insight-guard",
  "version": "0.2.0",
  "description": "Assess and verify DeFi agent transactions with Insight risk evidence and optional PriorSeal authorization.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imokokok/Insight.git",
    "directory": "sdk"
  },
  "homepage": "https://www.oracleinsight.xyz/sdk",
  "bugs": "https://github.com/imokokok/Insight/issues",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
