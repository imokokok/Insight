[
  {
    "name": "trade_guard",
    "description": "Use it for every pre-execution trust decision: one oracle price, price analytics, oracle health, oracle registry search, a venue market quote, or the pre-trade safety gate including prepare_swap and prepare_perp_order. Each call selects the branch with \"op\". Do not use it to prove execution after the fact (use trade_proof), to poll a prepaid monitoring window (use oracle_watch_window), or to manage a position bundle (use position_lifecycle). Returns the op payload: price and analytics rows for read ops, a venue quote for market_quote, a PASS/CAUTION/DANGER/BLOCK verdict with reasons for check_safety, and an unsigned prepared transaction, Solana message, venue order or instruction for prepare_* ops. Absorbs the deprecated names get_oracle_price, get_price_analytics, get_oracle_health, search_oracle_registry, get_market_quote, check_trade_safety, prepare_swap and prepare_perp_order. Metering: oracle_price, market_quote and search_registry are 2 credits ($0.002); price_analytics and oracle_health are 4 credits ($0.004); check_safety, prepare_swap and prepare_perp_order are 40 credits ($0.040), which is both the per-call price and the product ceiling. Deprecated alias spellings are callable at the same price until 2027-01-06.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "oracle_price",
            "price_analytics",
            "oracle_health",
            "search_registry",
            "market_quote",
            "check_safety",
            "prepare_swap",
            "prepare_perp_order"
          ]
        },
        "provider": {
          "description": "Oracle provider, e.g. chainlink, redstone, api3",
          "type": "string"
        },
        "asset": {
          "description": "Asset symbol, e.g. BTC, ETH",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "chain": {
          "description": "Optional blockchain filter, e.g. base",
          "type": "string"
        },
        "force_refresh": {
          "description": "Bypass cache and re-read upstream",
          "type": "boolean"
        },
        "assets": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "description": "Assets to analyse; consensus/risk/history use the first asset"
        },
        "mode": {
          "anyOf": [
            {
              "default": "consensus",
              "description": "consensus = cross-provider price, batch = multi-asset, history = time series",
              "type": "string",
              "enum": ["consensus", "batch", "history"]
            },
            {
              "default": "pre_trade",
              "description": "Generic oracle gate mode when no family-specific guard applies",
              "type": "string",
              "enum": ["pre_trade", "preflight"]
            }
          ]
        },
        "metric": {
          "anyOf": [
            {
              "description": "Deep-analysis metric; overrides mode",
              "type": "string",
              "enum": ["spreads", "deviation", "correlation", "risk"]
            },
            {
              "description": "Optional metric selector; defaults to the scope default",
              "type": "string",
              "enum": [
                "health",
                "uptime",
                "exposure",
                "peg",
                "latency",
                "anomalies",
                "coverage",
                "counts",
                "report"
              ]
            }
          ]
        },
        "providers": {
          "anyOf": [
            {
              "description": "Required for metric=risk; otherwise uses the provider default",
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "description": "Oracle providers to gate on",
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "method": {
          "description": "Consensus aggregation method",
          "type": "string",
          "enum": ["median", "trimmed_mean", "weighted_median", "iqr_filtered"]
        },
        "base_chain": {
          "description": "Base chain name for metric=spreads",
          "type": "string"
        },
        "from": {
          "description": "Start date YYYY-MM-DD",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "to": {
          "description": "End date YYYY-MM-DD",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "interval": {
          "description": "Deviation interval, default 24h",
          "type": "string",
          "enum": ["1h", "6h", "24h"]
        },
        "period_hours": {
          "description": "Risk/history hours",
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        },
        "scope": {
          "default": "ecosystem",
          "description": "Which health surface to read",
          "type": "string",
          "enum": [
            "ecosystem",
            "feeds",
            "feed",
            "providers",
            "provider",
            "protocol",
            "asset",
            "incidents"
          ]
        },
        "subject": {
          "description": "Feed UUID, provider, protocol, or asset symbol depending on scope",
          "type": "string",
          "minLength": 1
        },
        "period": {
          "description": "Period in hours or days",
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        },
        "days": {
          "description": "Lookback days for rankings/trends",
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "date": {
          "description": "Report date YYYY-MM-DD",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "category": {
          "description": "Feed category filter",
          "type": "string",
          "enum": ["crypto", "stablecoin", "forex", "commodity", "wrapped", "lst"]
        },
        "is_active": {
          "description": "Feed active-state filter, default true",
          "type": "boolean"
        },
        "min_severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "chain_id": {
          "anyOf": [
            {
              "description": "Chain filter",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "string",
              "const": "solana"
            },
            {
              "type": "string",
              "const": "hyperliquid"
            }
          ]
        },
        "limit": {
          "anyOf": [
            {
              "description": "Maximum rows",
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            {
              "description": "Maximum rows",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          ]
        },
        "offset": {
          "description": "Pagination offset",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "string",
          "enum": [
            "symbols",
            "feeds",
            "protocols",
            "stablecoins",
            "protocol_params",
            "rwa_instrument",
            "rwa_context",
            "settlement_evidence",
            "setup_recommendation"
          ],
          "description": "Registry/evidence family to search"
        },
        "query": {
          "description": "Search or lookup term (symbol, protocol, slug)",
          "type": "string",
          "minLength": 1
        },
        "verify_onchain": {
          "description": "For RWA lookups, cross-check on chain",
          "type": "boolean"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "base_uniswap_v3",
                "base_aerodrome",
                "base_pancakeswap_v3",
                "bnb_pancakeswap_v3",
                "base_quickswap_v2",
                "base_venue_identity",
                "monad_uniswap_v3",
                "monad_hanji",
                "solana_jupiter",
                "hyperliquid_perp"
              ],
              "description": "Reviewed venue to quote"
            },
            {
              "type": "string",
              "enum": [
                "base_aerodrome_slipstream",
                "base_pancakeswap_v3",
                "bnb_pancakeswap_v3",
                "base_agent_swap",
                "solana_loopscale_vault",
                "solana_jupiter"
              ],
              "description": "Reviewed execution venue"
            }
          ]
        },
        "profile_id": {
          "description": "Reviewed pool/profile id. PancakeSwap V3: base-pancakeswap-v3-usdc-usdt-100, bnb-pancakeswap-v3-usdt-usdc-100, bnb-pancakeswap-v3-usdt-wbnb-100",
          "type": "string",
          "minLength": 1
        },
        "market": {
          "description": "Hyperliquid perp market",
          "type": "string",
          "enum": ["BTC", "ETH", "HYPE"]
        },
        "venues": {
          "description": "Base venue ids to inspect",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "type": "string",
          "enum": [
            "swap",
            "borrow",
            "repay",
            "lend",
            "open_perp",
            "close_perp",
            "check_position",
            "check_liquidation",
            "vault_deposit"
          ],
          "description": "Trade action being considered"
        },
        "amount_usd": {
          "description": "Trade size in USD",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "destination_asset": {
          "description": "Destination asset for swaps",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "protocol_id": {
          "description": "Lending/protocol id",
          "type": "string",
          "minLength": 1
        },
        "market_id": {
          "description": "Isolated lending market id when required",
          "type": "string",
          "minLength": 1
        },
        "side": {
          "description": "Perp side",
          "type": "string",
          "enum": ["open_long", "open_short"]
        },
        "margin_asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "margin_value_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loan_symbol": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "collateral_value_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "debt_value_usd": {
          "type": "number",
          "minimum": 0
        },
        "collateral_symbol": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "collateral_amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "borrow_symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "borrow_amount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "collaterals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["symbol", "amount"]
          }
        },
        "borrows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": ["symbol", "amount"]
          }
        },
        "position": {
          "description": "Position payload for action=check_position",
          "type": "object",
          "properties": {
            "protocol_id": {
              "type": "string",
              "minLength": 1
            },
            "collaterals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["symbol", "amount"]
              }
            },
            "borrows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["symbol", "amount"]
              }
            },
            "collateral_symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "collateral_amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "borrow_symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "borrow_amount": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "token_address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "decision_input": {
          "description": "Caller decision/quote evidence (old camelCase shape)",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "guard": {
          "description": "Exact-call guard input for family-specific exact tools",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "transaction": {
          "description": "Exact unsigned transaction for exact-call guards"
        },
        "order": {
          "description": "Exact Hyperliquid order envelope"
        },
        "reputation_opt_in": {
          "type": "boolean"
        },
        "reputation_agent_id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "direction": {
          "type": "string",
          "enum": ["token0-to-token1", "token1-to-token0"]
        },
        "amount_in": {
          "type": "string",
          "minLength": 1,
          "description": "Exact input amount as a decimal string"
        },
        "recipient": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "deadline_unix_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_slippage_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "source_decision_price_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "destination_decision_price_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "policy": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "wallet": {
          "type": "string",
          "minLength": 1
        },
        "vault": {
          "type": "string",
          "minLength": 1
        },
        "asset_mint": {
          "type": "string",
          "minLength": 1
        },
        "input_mint": {
          "description": "Solana base58 mint sold; required for venue=solana_jupiter",
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "output_mint": {
          "description": "Solana base58 mint bought; required for venue=solana_jupiter",
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
        },
        "principal_amount": {
          "type": "string",
          "minLength": 1
        },
        "min_lp_amount": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["op"]
    },
    "pricing": {
      "credits": 40,
      "usd": "0.040",
      "minCredits": 2,
      "minUsd": "0.002"
    }
  },
  {
    "name": "trade_proof",
    "description": "Use it to open a trade-evidence session, issue an execution receipt, or verify an evidence artifact after a trade. Each call selects the branch with \"op\": begin_evidence, issue_receipt or verify_evidence. Do not use it to decide whether a trade is safe before signing (use trade_guard) and do not use it to settle a swap guard (use the venue guard tools). Returns the evidence session handle, the signed receipt, or the verification verdict, digest and matched evidence. Absorbs the deprecated names begin_trade_evidence, issue_execution_receipt and verify_evidence. Metering: begin_evidence and issue_receipt are C4 (40 credits / $0.040); verify_evidence is free for the three offline kinds (execution_pair, base_agent_swap, solana_swap) and C4 for live reads.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": ["begin_evidence", "issue_receipt", "verify_evidence"]
        },
        "asset": {
          "description": "Source asset sold",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "destination_asset": {
          "description": "Destination asset bought",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "chain_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Execution chain id. Independent on-chain route quotes are currently available only on Ethereum mainnet (chain_id 1); other chains return [unavailable:unsupported_chain] without billing."
        },
        "action": {
          "type": "string",
          "enum": ["swap", "borrow", "lend", "liquidate", "repay"]
        },
        "amount_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_slippage_bps": {
          "type": "number",
          "const": 50,
          "description": "Pre-committed tolerance; fixed at 50"
        },
        "protocol_id": {
          "type": "string"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_group_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "decision_input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Required quote evidence: {source, destination, routeQuotePrice, routeQuoteObservedAt} (old camelCase shape)"
        },
        "mode": {
          "type": "string",
          "enum": ["receipt", "settle_base_agent_swap", "settle_solana_swap"]
        },
        "receipt": {
          "description": "Required for mode=receipt; old execution_receipt fields",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "decision": {
          "description": "Required for settle modes; the signed guard decision",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "swap_tx_hash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "signature": {
          "description": "Solana transaction signature",
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["execution_pair", "base_agent_swap", "solana_swap", "hyperliquid_perp"]
        },
        "pre_trade_attestation": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "execution_receipt": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "destination_pre_trade_attestation": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "settlement": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "user": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "submitted_at": {
          "type": "string",
          "minLength": 1
        },
        "expected_order": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": ["op"]
    },
    "pricing": {
      "credits": 40,
      "usd": "0.040"
    }
  },
  {
    "name": "oracle_watch_window",
    "description": "Oracle Watch for monitored trust signals. Use it to read one trust snapshot or history series, buy a 24h monitored window, or poll/close an already purchased window. Each call selects the branch with \"op\": snapshot, history, begin, poll or close. Do not use it for pre-trade safety (use trade_guard op check_safety), do not buy a second window for the same subject, and never reuse a token after close. Returns the trust signal or history series, the windowId plus one-time oww_ token and expiry for begin, and the poll signal or combined close summary for window ops. Absorbs the deprecated names oracle_watch, oracle_watch_window_begin and oracle_watch_window_control. Metering: begin is 500 credits / $0.500 for the 24h window; in-window poll and close are covered (0 credits); snapshot and history are C3 (20 credits / $0.020).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": ["snapshot", "history", "begin", "poll", "close"]
        },
        "symbol": {
          "description": "Asset symbol to watch",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "chain": {
          "description": "Chain-name filter (e.g. \"ethereum\", \"base\", \"hyperevm\"); not a numeric chain id",
          "type": "string"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "interval": {
          "type": "string",
          "enum": ["30min", "hourly", "daily"]
        },
        "window_id": {
          "type": "string",
          "minLength": 1
        },
        "window_token": {
          "type": "string",
          "minLength": 1,
          "description": "One-time oww_ token from the purchase"
        }
      },
      "required": ["op"]
    },
    "pricing": {
      "credits": 500,
      "usd": "0.500"
    }
  },
  {
    "name": "position_lifecycle",
    "description": "Use it to buy a 24h Position Lifecycle bundle and run the guard, receipt and close steps inside it. Each call selects the branch with \"op\": begin, guard, receipt or close. Do not use it for a single pre-trade guard (use trade_guard op check_safety), for unrelated positions, or with a token after close. Returns the lifecycleId plus one-time plc_ token and expiry for begin, and the guard verdict, signed execution receipt or combined lifecycle summary for the in-window steps. Absorbs the deprecated names position_lifecycle_begin and position_lifecycle_step.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": ["begin", "guard", "receipt", "close"]
        },
        "symbol": {
          "description": "Position subject for the lifecycle",
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "chain": {
          "description": "Chain-name filter (e.g. \"ethereum\", \"base\", \"hyperevm\"); not a numeric chain id",
          "type": "string"
        },
        "lifecycle_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_token": {
          "type": "string",
          "minLength": 1,
          "description": "One-time plc_ token from the purchase"
        },
        "family": {
          "type": "string",
          "enum": [
            "base_perp",
            "bnb_perp",
            "hyperliquid_perp",
            "solana_perp",
            "base_lending",
