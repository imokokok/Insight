# Copy this file to .env.local and fill in your own values.
# Never commit .env.local to version control.

# x402 keyless paid tier (pre-trade endpoint).
# Armed only when X402_ENABLED is exactly "true" and at least one enabled
# network has a valid pay-to address. X402_PAY_TO controls every configured
# EVM network; the separate X402_SOLANA_* settings control Solana. Leave both
# recipients empty to keep the endpoint's anonymous behaviour unchanged (401).
# Use dedicated receiving wallets; funds arrive as USDC via the configured x402
# facilitator (no server signing key needed). The facilitator must advertise
# support for the exact x402 v2 scheme and network(s) enabled below.
X402_ENABLED=false
# Set false when enabling Solana without activating a configured EVM recipient.
# Unset/true preserves the existing EVM behavior when X402_ENABLED is true.
X402_EVM_ENABLED=true
X402_NETWORK=eip155:84532
X402_PAY_TO=
X402_PRICE_USD=0.02
X402_FACILITATOR_URL=https://x402.org/facilitator
# Optional comma-separated x402 EVM networks. If unset, X402_NETWORK is the
# only EVM option. X402_NETWORK remains the single network used by MPP.
# Every listed network must be advertised by the selected facilitator at
# /supported.
# X402_EVM_NETWORKS=eip155:8453,eip155:1,eip155:10,eip155:42161,eip155:137,eip155:43114,eip155:1329,eip155:196
# The same EVM pay-to address is reused on each chain; balances remain
# chain-specific.

# Optional Solana x402 V2 exact/USDC option. The master X402_ENABLED switch
# must also be true. Set X402_EVM_ENABLED=false to enable only Solana. Defaults
# to Devnet so opting in cannot silently charge on
# Mainnet. Use the CAIP-2 value shown below; set the Mainnet value explicitly
# only after the facilitator's /supported endpoint confirms exact support.
# X402_SOLANA_PAY_TO is the receiving wallet owner (base58 public key), not a
# secret. Its USDC associated token account must already exist; provision it
# idempotently before enabling this route. No server signing key is needed.
X402_SOLANA_ENABLED=false
X402_SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
X402_SOLANA_PAY_TO=
X402_SOLANA_PRICE_USD=0.02

# Optional MPP (Machine Payments Protocol) rail for the REST pre-trade check.
# MPP remains EVM-only and uses the EVM X402_* price, X402_NETWORK,
# X402_PAY_TO, and facilitator;
# set this opt-in flag and a private HMAC key (at least 32 bytes) to advertise
# both protocols on the same endpoint. Generate a key with: openssl rand -base64 32
# This setting does not enable MPP for the MCP endpoint.
MPP_ENABLED=false
MPP_SECRET_KEY=

# CDP facilitator auth — REQUIRED when X402_FACILITATOR_URL points at
# https://api.cdp.coinbase.com/platform/v2/x402 (Coinbase's hosted facilitator,
# which feeds the Bazaar/Agentic.Market discovery index). Create a Secret API
# key at portal.cdp.coinbase.com -> Settings -> API Keys. The two values must
# be set together; config parsing fails loudly if the CDP URL is set without
# them.
X402_CDP_API_KEY_ID=
X402_CDP_API_KEY_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional public CEX market-reference sources for local collector/backfill
# runs. Leave empty unless written commercial data permissions cover the use
# and migration 0087 is applied to the target database. Supported values:
# bitstamp,bitfinex,binance. Binance currently supports WBTC/USD via the
# WBTC/USDT × USDT/USD spot-market conversion.
MARKET_REFERENCE_LICENSED_EXCHANGES=

# Internal API / CSRF secrets (generate strong random strings)
INTERNAL_API_SECRET=your-internal-api-secret
CSRF_SECRET=your-csrf-secret
JWT_SECRET=your-jwt-secret

# API protection / observability
MAX_REQUEST_SIZE=1048576
# Production defaults to warn; override with debug, info, warn, or error.
LOG_LEVEL=warn

# Cron job protection
CRON_SECRET=your-cron-secret

# MCP HTTP protection
# Set to false only for local development. Defaults to true in production.
MCP_AUTH_REQUIRED=false
# Optional shared bearer token for team/internal MCP HTTP deployments.
# If set, clients can authenticate with Authorization: Bearer <MCP_BEARER_TOKEN>
MCP_BEARER_TOKEN=your-mcp-shared-secret

# RPC endpoints (examples)
# Dedicated 32-byte Ed25519 seed for signed Solana simulation/execution evidence.
# Generate offline with a cryptographically secure random source; keep it private.
INSIGHT_SOLANA_EVIDENCE_SIGNER_SEED=

ALCHEMY_ETHEREUM_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_OPTIMISM_RPC=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
ALCHEMY_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# GoPlus Console app credentials. The server exchanges these for a short-lived
# access token; use the returned token verbatim for the API Authorization header.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# Robinhood Chain Stock Token ERC-8056 verification. When unset, the
# rate-limited public RPC is used and labeled as such; configure this in production.
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
# Set from Chainlink's official feed directory after verifying the Robinhood Chain AAPL/USD entry.
CHAINLINK_RHJ_AAPL_FEED=

# Alpaca Market Data API local development check only. Do not expose these keys
# to browser code or commit them. Commercial use remains disabled until Alpaca
# provides written approval and any required license.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DEV_TEST_STOCK_SYMBOLS=AAPL
ALPACA_DEV_TEST_STOCK_FEED=iex

# Billing (NOWPayments crypto — USDC-denominated)
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-ipn-secret
# Only set to 'true' for sandbox testing (api-sandbox.nowpayments.io).
# Real payments use the production API by default; DO NOT set this unless you
# explicitly want test/sandbox mode (a stage logging WILL warn loudly).
NOWPAYMENTS_TEST_MODE=true

# Oracle safety attestation signer (optional)
# When set, every pre-trade safety check is signed as an EIP-712 offchain
# attestation — a portable, verifiable proof agents relay in tx memo/logs.
# Generate a DEDICATED key (do NOT reuse an operational wallet key):
#   npx tsx scripts/generate-attester-key.ts
# The script prints both the private key (below) and the public attester address.
# Verify it is active: GET /api/v1/safety/attestation/verify -> attestationEnabled: true
# The attester's public address is published at that endpoint so third parties
# know which signer to trust. Unset = feature disabled (non-breaking).
ATTESTATION_SIGNER_PRIVATE_KEY=

# Public app URL — used to build the attestation's verifyUrl + canonical links.
# Required in production; the verifyUrl falls back to localhost:3000 in dev if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Headless Oracle production market-state access.
# A bridge/API key is the safest option for the anonymous public envelope while
# bounded x402 spending is being wired. It is sent as X-Oracle-Key.
HEADLESS_ORACLE_API_KEY=
# Stock x402 v2 client (Base mainnet, exact 0.001 USDC only). Payment remains
# disabled unless this flag is exactly "true". Use a DEDICATED, balance-limited
# payer key; never reuse an attestation signer or treasury key. Enabling this on
# an anonymous public route permits callers to trigger real spend, so configure
# an operator-approved cumulative budget before enabling it in production.
HEADLESS_X402_ENABLED=false
HEADLESS_X402_PRIVATE_KEY=

# WalletConnect (mobile / no-injected-wallet QR connect).
# Free projectId from https://cloud.walletconnect.com — required to show the
# "WalletConnect" QR option on the safety-check import screen. If unset, the
# desktop EIP-6963 wallet picker still works; only the mobile QR path is hidden.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
