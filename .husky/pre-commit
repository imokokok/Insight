#!/bin/sh
set -eu

# Fast local gate. scripts/precommit-checks.mjs plans and runs the static checks
# in parallel, skipping generated-artifact checks whose inputs were not staged.
# The full CI suite (full lint/typecheck/build/coverage/e2e) stays enforced by
# required GitHub Actions checks on protected branches; `npm run ci:local`
# reproduces it locally.
node scripts/precommit-checks.mjs
npx lint-staged
