#!/bin/sh
set -eu

# Automation already runs the repository's CI suite before publishing changes.
if [ "${GITHUB_ACTIONS:-}" = 'true' ]; then
  exit 0
fi

expected_node="v$(cat .node-version)"
actual_node="$(node --version)"
if [ "$actual_node" != "$expected_node" ]; then
  echo "CI preflight requires Node $expected_node (found $actual_node)." >&2
  exit 1
fi

# Lightweight preflight only. The heavy suite (verifier build, validate:ci,
# Playwright e2e) runs as required GitHub Actions checks on protected branches;
# run `npm run ci:local` for the complete suite locally.
npm run typecheck
npm run lint
