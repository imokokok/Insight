#!/bin/sh
set -eu

# Automation already runs the repository's CI suite before publishing changes.
if [ "${GITHUB_ACTIONS:-}" = 'true' ]; then
  exit 0
fi

# Switch to the repository's pinned Node version instead of failing the push.
required="$(cat .node-version)"
current="$(node --version 2>/dev/null | sed 's/^v//')"
if [ "$current" != "$required" ]; then
  if [ -s "$HOME/.nvm/nvm.sh" ]; then
    . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
    nvm use --silent "$required" >/dev/null 2>&1 || true
  elif command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env 2>/dev/null)" || true
    fnm use --silent "$required" >/dev/null 2>&1 || true
  fi
  current="$(node --version 2>/dev/null | sed 's/^v//')"
fi
if [ "$current" != "$required" ]; then
  echo "warning: repository pins Node $required, running $current" >&2
fi

# Pre-commit already linted and fixed the staged content, and the generated
# artifact checks ran there too. The complete suite (full lint, verifier build,
# validate:ci, Playwright e2e) is enforced by required GitHub Actions checks on
# protected branches, and can be reproduced locally with `npm run ci:local`.
# Keeping pre-push to the version guard means an unrelated uncommitted draft can
# never block publishing already-reviewed commits.
exit 0
