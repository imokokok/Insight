    {
      "name": "issue_execution_receipt",
      "description": "Close the loop after an agent executes: issue a signed execution-price receipt from the pre-trade handle plus the settlement transaction, or settle a guarded Base/Solana swap. Use it only after the trade settled. Do not use it before execution and do not treat the verdict as principal authorization. Returns a signed receipt or settlement with FAITHFUL/DEVIATED/NOT_EXECUTED/UNDETERMINED (or settlement status), price delta, binding ids and verify URL.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["receipt", "settle_base_agent_swap", "settle_solana_swap"]
          },
          "receipt": {
            "description": "Required for mode=receipt; old execution_receipt fields",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "decision": {
            "description": "Required for settle modes; the signed guard decision",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "swap_tx_hash": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          },
          "signature": {
            "description": "Solana transaction signature",
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["mode"]
      }
    },
    {
      "name": "verify_evidence",
      "description": "Verify signed evidence produced by Insight or by an agent: a pre-trade/execution pair, a Base agent-swap settlement, a Solana swap settlement, or one Hyperliquid order/fill record. Use it when a third party needs to check binding and signatures before trusting a claim. Do not use it to re-assess oracle risk or to authorize trading. Returns valid/invalid, the closed-loop or settlement status, binding assertions and machine-readable reasons.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["execution_pair", "base_agent_swap", "solana_swap", "hyperliquid_perp"]
          },
          "pre_trade_attestation": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "execution_receipt": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "destination_pre_trade_attestation": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "settlement": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "user": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "order_id": {
            "type": "string",
            "minLength": 1
          },
          "submitted_at": {
            "type": "string",
            "minLength": 1
          },
          "expected_order": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["kind"]
      }
    },
    {
      "name": "oracle_watch",
      "description": "Read one oracle-trust snapshot or historical series for an asset. Use it for a one-off check of whether a symbol is currently trustworthy or how its recent history looks. Do not use it for continuous monitoring — buy a 24h window with oracle_watch_window_begin. Returns the current trust signal (or the requested history series) with provider participation and freshness.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "op": {
            "default": "snapshot",
            "type": "string",
            "enum": ["snapshot", "history"]
          },
          "symbol": {
            "description": "Asset symbol to watch",
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "chain": {
            "type": "string"
          },
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 90
          },
          "interval": {
            "type": "string",
            "enum": ["30min", "hourly", "daily"]
          }
        },
        "required": ["symbol"]
      }
    },
    {
      "name": "oracle_watch_window_begin",
      "description": "Buy a 24h Oracle Watch window for one asset and return the one-time control token. Use it when an agent will poll throughout a window instead of paying per snapshot. Do not use it repeatedly for the same window and never share the token. Returns windowId, the oww_ token, the covered expiry and the credits charged.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "symbol": {
            "description": "Asset to monitor for the window",
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "chain": {
            "type": "string"
          }
        },
        "required": ["symbol"]
      }
    },
    {
      "name": "oracle_watch_window_control",
      "description": "Poll or close an already purchased Oracle Watch window using its one-time oww_ token. Poll returns a fresh signal at zero extra credits; close returns the complete window summary and the final signal. Use it only with a window token from oracle_watch_window_begin. Do not use it for a one-off snapshot (oracle_watch) and never reuse a token after close. Returns the signal (poll) or the combined summary (close).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
