{
  "serverInfo": {
    "name": "insight-oracle-mcp-server",
    "version": "0.1.0"
  },
  "authentication": {
    "required": false,
    "schemes": []
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "tools": [
    {
      "name": "get_oracle_price",
      "description": "Read the current price one oracle provider reports for one asset. Use it for a single fresh or cached provider read (for example when a route quote needs a reference price). Do not use it for cross-provider consensus, historical series, deviation or risk analytics — use get_price_analytics instead. Returns the price, provider, symbol, chain, confidence/decimals, source timestamp and cache status.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "provider": {
            "description": "Oracle provider, e.g. chainlink, redstone, api3",
            "type": "string"
          },
          "asset": {
            "description": "Asset symbol, e.g. BTC, ETH",
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "chain": {
            "description": "Optional blockchain filter, e.g. base",
            "type": "string"
          },
          "force_refresh": {
            "description": "Bypass cache and re-read upstream",
            "type": "boolean"
          }
        },
        "required": ["provider", "asset"]
      }
    },
    {
      "name": "get_price_analytics",
      "description": "Run multi-oracle price analytics: consensus across providers, batch reads, historical series, cross-chain spreads, deviation, correlation or a risk summary. Use it when one price is not enough and the caller needs to compare, stress or trend oracle data. Do not use it for a single provider spot read (get_oracle_price) or for feed uptime (get_oracle_health). Returns the requested analysis rows plus provider participation and reference prices.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "assets": {
            "minItems": 1,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20
            },
            "description": "Assets to analyse; consensus/risk/history use the first asset"
          },
          "mode": {
            "default": "consensus",
            "description": "consensus = cross-provider price, batch = multi-asset, history = time series",
            "type": "string",
            "enum": ["consensus", "batch", "history"]
          },
          "metric": {
            "description": "Deep-analysis metric; overrides mode",
            "type": "string",
            "enum": ["spreads", "deviation", "correlation", "risk"]
          },
          "providers": {
            "description": "Required for metric=risk; otherwise uses the provider default",
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider": {
            "description": "Provider for history/spreads",
            "type": "string"
          },
          "method": {
            "description": "Consensus aggregation method",
            "type": "string",
            "enum": ["median", "trimmed_mean", "weighted_median", "iqr_filtered"]
          },
          "chain": {
            "description": "Optional chain filter",
            "type": "string"
          },
          "base_chain": {
            "description": "Base chain for metric=spreads",
            "type": "string"
          },
          "from": {
            "description": "Start date YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "description": "End date YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "interval": {
            "description": "Deviation interval, default 24h",
            "type": "string",
            "enum": ["1h", "6h", "24h"]
          },
          "period_hours": {
            "description": "Risk/history hours",
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          },
          "force_refresh": {
            "type": "boolean"
          }
        },
        "required": ["assets"]
      }
    },
    {
      "name": "get_oracle_health",
      "description": "Read oracle ecosystem, feed, provider, protocol or asset health. Use it to answer freshness, uptime, latency, anomaly, coverage, peg, exposure, incident and daily-report questions before trusting a price or a protocol. Do not use it for a price quote (get_oracle_price) or for a trade gate (check_trade_safety). Returns the matching health rows, verdicts, counts and timestamps for the selected scope.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "scope": {
            "default": "ecosystem",
            "description": "Which health surface to read",
            "type": "string",
            "enum": [
              "ecosystem",
              "feeds",
              "feed",
              "providers",
              "provider",
              "protocol",
              "asset",
              "incidents"
            ]
          },
          "subject": {
            "description": "Feed UUID, provider, protocol, or asset symbol depending on scope",
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "description": "Optional metric selector; defaults to the scope default",
            "type": "string",
            "enum": [
              "health",
              "uptime",
              "exposure",
              "peg",
              "latency",
              "anomalies",
              "coverage",
              "counts",
              "report"
            ]
          },
          "period": {
            "description": "Period in hours or days",
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          },
          "days": {
            "description": "Lookback days for rankings/trends",
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "date": {
            "description": "Report date YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "from": {
            "description": "Start date YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "description": "End date YYYY-MM-DD",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "category": {
            "description": "Feed category filter",
            "type": "string",
            "enum": ["crypto", "stablecoin", "forex", "commodity", "wrapped", "lst"]
          },
          "is_active": {
            "description": "Feed active-state filter, default true",
            "type": "boolean"
          },
          "min_severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "provider": {
            "description": "Provider filter",
            "type": "string"
          },
          "chain_id": {
            "description": "Chain filter",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "limit": {
            "description": "Maximum rows",
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "offset": {
            "description": "Pagination offset",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "name": "search_oracle_registry",
      "description": "Search Insight-reviewed registry and evidence resources: symbols, feeds, protocols, stablecoins, protocol risk parameters, RWA instruments/context, settlement-evidence packs and oracle setup recommendations. Use it to discover the exact ids a price, safety or execution tool expects. Do not use it to read live prices or health. Returns matching registry rows or one lookup record, with ids and reviewed metadata.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "symbols",
              "feeds",
              "protocols",
              "stablecoins",
              "protocol_params",
              "rwa_instrument",
              "rwa_context",
              "settlement_evidence",
              "setup_recommendation"
            ],
            "description": "Registry/evidence family to search"
          },
          "query": {
            "description": "Search or lookup term (symbol, protocol, slug)",
            "type": "string",
            "minLength": 1
          },
          "chain_id": {
            "description": "Chain filter for feeds",
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "category": {
            "description": "Feed category filter",
            "type": "string",
            "enum": ["crypto", "stablecoin", "forex", "commodity", "wrapped", "lst"]
          },
          "is_active": {
            "description": "Feed active-state filter, default true",
            "type": "boolean"
          },
          "limit": {
            "description": "Maximum rows",
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "description": "Pagination offset",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "verify_onchain": {
            "description": "For RWA lookups, cross-check on chain",
            "type": "boolean"
          }
        },
        "required": ["kind"]
      }
    },
    {
      "name": "get_market_quote",
      "description": "Read one reviewed venue market: pool/market metadata, pinned quote context and venue constraints for Base, Monad, Solana or Hyperliquid. Use it before preparing or gating a trade when the agent needs the reviewed profile or market id. Do not use it as execution authorization or for prices outside the reviewed venues. Returns the market record, reviewed profile ids and current quote context.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "venue": {
            "type": "string",
            "enum": [
              "base_uniswap_v3",
              "base_aerodrome",
              "base_pancakeswap_v3",
              "bnb_pancakeswap_v3",
              "base_quickswap_v2",
              "base_venue_identity",
              "monad_uniswap_v3",
              "monad_hanji",
              "solana_jupiter",
              "hyperliquid_perp"
            ],
            "description": "Reviewed venue to quote"
          },
          "profile_id": {
            "description": "Reviewed pool/profile id. PancakeSwap V3: base-pancakeswap-v3-usdc-usdt-100, bnb-pancakeswap-v3-usdt-usdc-100, bnb-pancakeswap-v3-usdt-wbnb-100",
            "type": "string",
            "minLength": 1
          },
          "market": {
            "description": "Hyperliquid perp market",
            "type": "string",
            "enum": ["BTC", "ETH", "HYPE"]
          },
          "venues": {
            "description": "Base venue ids to inspect",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["venue"]
      }
    },
    {
      "name": "check_trade_safety",
      "description": "Run the pre-trade oracle safety gate for swaps, lending, perps, vault deposits and position stress tests across Base, Monad, multichain EVM, Solana and Hyperliquid. Use it immediately before an agent trades or signs, and pass the family native payload in `guard` when the venue needs exact-call fields. Do not use it after execution (use issue_execution_receipt) and do not treat its ALLOW as principal authorization. Returns a verdict (ALLOW/CAUTION/DANGER/BLOCK), reason codes, oracle evidence and a signed attestation or decision when the family supports one.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "chain_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              {
                "type": "string",
                "const": "solana"
              },
              {
                "type": "string",
                "const": "hyperliquid"
              }
            ],
            "description": "Execution chain: numeric EVM id, \"solana\", or \"hyperliquid\""
          },
          "action": {
            "type": "string",
            "enum": [
              "swap",
              "borrow",
              "repay",
              "lend",
              "open_perp",
              "close_perp",
              "check_position",
              "check_liquidation",
              "vault_deposit"
            ],
            "description": "Trade action being considered"
          },
          "asset": {
            "description": "Asset traded or collateral symbol",
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "amount_usd": {
            "description": "Trade size in USD",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "destination_asset": {
            "description": "Destination asset for swaps",
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "mode": {
            "default": "pre_trade",
            "description": "Generic oracle gate mode when no family-specific guard applies",
            "type": "string",
            "enum": ["pre_trade", "preflight"]
          },
          "protocol_id": {
            "description": "Lending/protocol id",
            "type": "string",
            "minLength": 1
          },
          "market_id": {
            "description": "Isolated lending market id when required",
            "type": "string",
            "minLength": 1
          },
          "market": {
            "description": "Perp market",
            "type": "string",
            "enum": ["BTC", "ETH", "HYPE"]
          },
          "profile_id": {
            "description": "Reviewed pool/profile id",
            "type": "string",
            "minLength": 1
          },
          "side": {
            "description": "Perp side",
            "type": "string",
            "enum": ["open_long", "open_short"]
          },
          "margin_asset": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "margin_value_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "loan_symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "collateral_value_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "debt_value_usd": {
            "type": "number",
            "minimum": 0
          },
          "collateral_symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "collateral_amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "borrow_symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "borrow_amount": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "collaterals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": ["symbol", "amount"]
            }
          },
          "borrows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "symbol": {
                  "type": "string",
                  "minLength": 1
                },
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": ["symbol", "amount"]
            }
          },
          "position": {
            "description": "Position payload for action=check_position",
            "type": "object",
            "properties": {
              "protocol_id": {
                "type": "string",
                "minLength": 1
              },
              "collaterals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": ["symbol", "amount"]
                }
              },
              "borrows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "amount": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": ["symbol", "amount"]
                }
              },
              "collateral_symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "collateral_amount": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "borrow_symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "borrow_amount": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "providers": {
            "description": "Oracle providers to gate on",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "token_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "decision_input": {
            "description": "Caller decision/quote evidence (old camelCase shape)",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "guard": {
            "description": "Exact-call guard input for family-specific exact tools",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "transaction": {
            "description": "Exact unsigned transaction for exact-call guards"
          },
          "order": {
            "description": "Exact Hyperliquid order envelope"
          },
          "date": {
            "description": "Date for liquidation stress",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reputation_opt_in": {
            "type": "boolean"
          },
          "reputation_agent_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["chain_id", "action"]
      }
    },
    {
      "name": "begin_trade_evidence",
      "description": "Open the verifiable execution loop: certify a swap/DeFi intent before the agent executes. Use it when a principal needs a signed pre-trade handle to bind an execution receipt later. Do not use it as trade authorization and do not call it after the trade. Returns preTradeUid, destinationPreTradeUid, requestHash, CAIP-19 asset ids, certified cross-rate, the 50 bps band, verdicts and the signed pre-trade attestations.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "asset": {
            "description": "Source asset sold",
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "destination_asset": {
            "description": "Destination asset bought",
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "chain_id": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Execution chain id"
          },
          "action": {
            "type": "string",
            "enum": ["swap", "borrow", "lend", "liquidate", "repay"]
          },
          "amount_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "max_slippage_bps": {
            "type": "number",
            "const": 50,
            "description": "Pre-committed tolerance; fixed at 50"
          },
          "protocol_id": {
            "type": "string"
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_group_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "decision_input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Required quote evidence: {source, destination, routeQuotePrice, routeQuoteObservedAt} (old camelCase shape)"
          }
        },
        "required": [
          "asset",
          "destination_asset",
          "chain_id",
          "action",
          "amount_usd",
          "max_slippage_bps",
          "decision_input"
        ]
      }
    },
    {
      "name": "prepare_swap",
      "description": "Prepare unsigned, reviewed swap calldata for local signing on Base Aerodrome Slipstream, Base PancakeSwap V3, the Base agent swap guard, or a Solana Loopscale vault deposit. Use it when the user wants an executable transaction bound to a reviewed pool and policy. Do not use it to sign, submit or route arbitrary calldata, and do not skip the matching safety gate. Returns the unsigned transaction envelope (to/value/calldata), reviewed profile, quote and, where supported, a signed decision.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "venue": {
            "type": "string",
            "enum": [
              "base_aerodrome_slipstream",
              "base_pancakeswap_v3",
              "bnb_pancakeswap_v3",
              "base_agent_swap",
              "solana_loopscale_vault",
              "solana_jupiter"
            ],
            "description": "Reviewed execution venue"
          },
          "direction": {
            "type": "string",
            "enum": ["token0-to-token1", "token1-to-token0"]
          },
          "amount_in": {
            "type": "string",
            "minLength": 1,
            "description": "Exact input amount as a decimal string"
          },
          "recipient": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "deadline_unix_seconds": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "max_slippage_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          },
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "source_decision_price_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "destination_decision_price_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "policy": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "wallet": {
            "type": "string",
            "minLength": 1
          },
          "vault": {
            "type": "string",
            "minLength": 1
          },
          "asset_mint": {
            "type": "string",
            "minLength": 1
          },
          "input_mint": {
            "description": "Solana base58 mint sold; required for venue=solana_jupiter",
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "output_mint": {
            "description": "Solana base58 mint bought; required for venue=solana_jupiter",
            "type": "string",
            "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
          },
          "collateral_symbol": {
            "type": "string",
            "minLength": 1
          },
          "loan_symbol": {
            "type": "string",
            "minLength": 1
          },
          "collateral_value_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "principal_amount": {
            "type": "string",
            "minLength": 1
          },
          "min_lp_amount": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["venue", "amount_in"]
      }
    },
    {
      "name": "prepare_perp_order",
      "description": "Prepare an unsigned perpetual order for one reviewed venue, without signing or submitting it. Venue decides the artifact shape: hyperliquid returns an unsigned exchange order envelope (HyperCore); synthetix-perps-v3-base returns EVM calldata for commitOrder whose acceptablePrice is derived from Insight cross-oracle consensus, not the Synthetix mark price; aster-perps-bnb-mainnet returns a canonical centralized REST order payload (not calldata, and it proves payload binding rather than on-chain execution); solana_drift returns a Borsh instruction payload that the caller must complete with the Drift SDK. The reviewed guard runs inside each adapter, so the result carries the risk verdict reference. Use it when an agent has decided on venue, market, side and size. Do not use it to create a nonce, sign, or submit an order. Returns the shared prepared-execution envelope: `state` (READY, CAUTION, REQUIRES_COMPLETION, BLOCK or UNAVAILABLE), a payload whose `kind` is `evm-transaction`, `venue-rest-order`, `solana-instruction` or null, a required `validity_anchor` (timestamp, EVM block, Solana block height or venue policy), caller requirements and the guard verdict reference. It never returns a uniformly described executable trade package, and a payload that still needs caller completion is never labelled READY. A `venue-rest-order` payload exposes `execution_binding` with `proves_onchain_execution: false` and the `signing` requirement. Solana message payloads carry `transactionHash` (sha256 of the exact unsigned bytes, byte binding only, not signature-verifiable) and `messageHash` (null when the message segment cannot be derived).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "venue": {
                "type": "string",
                "const": "hyperliquid",
                "description": "HyperCore perpetual venue"
              },
              "market": {
                "type": "string",
                "enum": ["BTC", "ETH", "HYPE"]
              },
              "side": {
                "type": "string",
                "enum": ["buy", "sell"]
              },
              "size": {
                "type": "string",
                "minLength": 1,
                "description": "Exact base size decimal string"
              },
              "limit_price": {
                "type": "string",
                "minLength": 1,
                "description": "Exact IOC limit price decimal string"
              },
              "reduce_only": {
                "type": "boolean"
              },
              "client_order_id": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{32}$"
              },
              "max_notional_usd": {
                "type": "number",
                "minimum": 1,
                "maximum": 1000000000
              },
              "max_price_impact_bps": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "max_mark_oracle_deviation_bps": {
                "type": "number",
                "minimum": 0,
                "maximum": 10000
              },
              "require_full_fill": {
                "type": "boolean"
              },
              "expires_after_seconds": {
                "type": "integer",
                "minimum": 5,
                "maximum": 120
              },
              "builder_fee": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "venue",
              "market",
              "side",
              "size",
              "limit_price",
              "reduce_only",
              "client_order_id",
              "max_notional_usd",
              "max_price_impact_bps",
              "max_mark_oracle_deviation_bps"
            ]
          },
          {
            "type": "object",
            "properties": {
              "venue": {
                "type": "string",
                "const": "synthetix-perps-v3-base"
              },
              "market": {
                "type": "string",
                "enum": ["BTC", "ETH", "SOL", "XRP", "DOGE", "PEPE"]
              },
              "side": {
                "type": "string",
                "enum": ["buy", "sell"],
                "description": "buy maps to open_long, sell to open_short"
              },
              "quantity": {
                "type": "string",
                "minLength": 1,
                "description": "Exact base-asset quantity decimal string"
              },
              "leverage": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "max_slippage_bps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "order_type": {
                "type": "string",
                "enum": ["market", "limit"]
              },
              "limit_price": {
                "type": "string",
                "minLength": 1
              },
              "account_id": {
                "anyOf": [
                  {
