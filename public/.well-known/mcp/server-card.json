                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
                "description": "Drift order authority / fee payer"
              },
              "user_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              },
              "expires_after_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 300
              }
            },
            "required": ["venue", "market", "side", "size_usd", "margin_value_usd", "wallet"]
          }
