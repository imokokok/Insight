          "window_id": {
            "type": "string",
            "minLength": 1
          },
          "window_token": {
            "type": "string",
            "minLength": 1,
            "description": "One-time oww_ token from the purchase"
          }
        },
        "required": ["op", "window_id", "window_token"]
      }
    },
    {
      "name": "position_lifecycle_begin",
      "description": "Buy a 24h Position Lifecycle bundle for one position subject and return the one-time control token. Use it when an agent needs guard, execution-receipt and close steps inside one prepaid window. Do not use it for a single guard (use check_trade_safety) and never share the token. Returns lifecycleId, the plc_ token, the covered expiry and the credits charged.",
      "inputSchema": {
