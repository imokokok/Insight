{
  "name": "insight",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run perf:budget",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "validate": "npm run lint && npm run typecheck && npm run typecheck:scripts && npm run test && npm run knip",
    "validate:ci": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:scripts && npm run test:coverage && npm run knip && npm run sdk:build && npm run sdk:test && npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sdk:build": "npm --prefix sdk run build",
    "sdk:test": "npm --prefix sdk test",
    "knip": "knip",
    "audit:api": "node scripts/api-usage-audit.mjs",
    "perf:budget": "node scripts/check-home-bundle-budget.mjs",
    "audit:raul": "node scripts/api-usage-audit.mjs --name ThoughtProof",
    "verify:vrt1": "node scripts/vrt1-e2e-prototype/verify/verify-round2.mjs && node scripts/vrt1-e2e-prototype/verify/verify-round3.mjs && node scripts/vrt1-e2e-prototype/verify/verify-scale-pin.mjs",
    "clean:dev": "rm -rf .next && next dev",
    "clean:start": "rm -rf .next && next build && next start",
    "mcp:stdio": "tsx src/mcp/index.ts",
    "mcp:http": "tsx src/mcp/http-server.ts",
    "sync:chainlink-catalog": "tsx scripts/sync-chainlink-catalog.ts",
    "cron:reputation": "tsx scripts/reputation.ts",
    "cron:feed-cadence": "tsx scripts/feed-cadence.ts",
    "build:cron": "node scripts/build-cron-bundles.mjs",
    "test:mcp:e2e": "node --env-file=.env.local ./node_modules/.bin/jest src/mcp/__tests__/e2e.test.ts --testTimeout=120000 --runInBand",
    "prepare": "husky"
  },
  "dependencies": {
    "@api3/contracts": "^27.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scalar/api-reference-react": "^0.9.66",
    "@sentry/nextjs": "^10.73.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-query-devtools": "^5.99.0",
    "@tanstack/react-virtual": "^3.13.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@walletconnect/ethereum-provider": "^2.23.10",
    "canonicalize": "^4.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.15",
    "framer-motion": "^12.36.0",
    "fuse.js": "^7.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "supra-oracle-sdk": "^1.0.4",
    "tailwind-merge": "^3.5.0",
    "verify-insight-receipt": "^0.2.0",
    "viem": "^2.56.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@aave-dao/aave-address-book": "^4.57.0",
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "knip": "^6.4.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.{css,scss,sass}": [
      "prettier --write"
    ],
    "*.{yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "@hono/node-server": "^1.19.15",
    "browserslist": "^4.28.9",
    "d3-color": "^3.1.0",
    "ethers": "^6.17.0",
    "fast-uri": "^3.1.6",
    "fflate": "^0.8.3",
    "flatted": "^3.4.0",
    "hono": "^4.13.7",
    "ip-address": "^10.7.0",
    "postcss": "^8.5.28",
    "axios": "^1.20.0",
    "qs": "^6.16.0"
  }
}
