{
  "name": "verify-insight-receipt",
  "version": "0.1.0",
  "description": "Verify Insight oracle-safety receipts locally. No network, no API key, no dependency on Insight being online.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "oracle",
    "attestation",
    "eip712",
    "verification",
    "ai-agent"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "viem": "^2.47.6"
  }
}
