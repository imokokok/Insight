{
  "name": "verify-insight-receipt",
  "version": "0.3.0",
  "description": "Verify Insight pre-trade and Execution Receipts locally, including the closed-loop pair proof.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "verify-insight-offline": "./dist/offline.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "oracle",
    "attestation",
    "eip712",
    "verification",
    "ai-agent"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm --prefix .. run verifier:release:check"
  },
  "dependencies": {
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5"
  }
}
