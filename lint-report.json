•</span>\n                <span className=\"text-sm text-gray-600\">\n                  {t('band.bandProtocol.ecosystem.feature3')}\n                </span>\n              </li>\n              <li className=\"flex items-start gap-2\">\n                <span className=\"text-purple-500 mt-1\">•</span>\n                <span className=\"text-sm text-gray-600\">\n                  {t('band.bandProtocol.ecosystem.feature4')}\n                </span>\n              </li>\n            </ul>\n          </div>\n          <div className=\"space-y-4\">\n            <h4 className=\"font-medium text-gray-900\">\n              {t('band.bandProtocol.ecosystem.integrations')}\n            </h4>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div className=\"p-3 bg-gray-50\">\n                <p className=\"text-lg font-semibold text-gray-900\">25+</p>\n                <p className=\"text-xs text-gray-500\">{t('band.bandProtocol.ecosystem.dApps')}</p>\n              </div>\n              <div className=\"p-3 bg-gray-50\">\n                <p className=\"text-lg font-semibold text-gray-900\">8</p>\n                <p className=\"text-xs text-gray-500\">\n                  {t('band.bandProtocol.ecosystem.blockchains')}\n                </p>\n              </div>\n              <div className=\"p-3 bg-gray-50\">\n                <p className=\"text-lg font-semibold text-gray-900\">180+</p>\n                <p className=\"text-xs text-gray-500\">\n                  {t('band.bandProtocol.ecosystem.dataFeeds')}\n                </p>\n              </div>\n              <div className=\"p-3 bg-gray-50\">\n                <p className=\"text-lg font-semibold text-gray-900\">$850M+</p>\n                <p className=\"text-xs text-gray-500\">\n                  {t('band.bandProtocol.ecosystem.tvlSecured')}\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </DashboardCard>\n\n      {/* Ecosystem Stats */}\n      <DashboardCard title={t('band.bandProtocol.ecosystem.ecosystemStats')}>\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n          <div className=\"p-4 bg-purple-50\">\n            <div className=\"flex items-center gap-2 mb-2\">\n              <Zap className=\"w-4 h-4 text-purple-700\" />\n              <h4 className=\"font-medium text-purple-900\">\n                {t('band.bandProtocol.ecosystem.blockTime')}\n              </h4>\n            </div>\n            <p className=\"text-2xl font-bold text-purple-700\">~2.8s</p>\n            <p className=\"text-sm text-purple-600 mt-1\">\n              {t('band.bandProtocol.ecosystem.fastFinality')}\n            </p>\n          </div>\n          <div className=\"p-4 bg-purple-50\">\n            <div className=\"flex items-center gap-2 mb-2\">\n              <Globe className=\"w-4 h-4 text-purple-700\" />\n              <h4 className=\"font-medium text-purple-900\">\n                {t('band.bandProtocol.ecosystem.interoperability')}\n              </h4>\n            </div>\n            <p className=\"text-2xl font-bold text-purple-700\">IBC</p>\n            <p className=\"text-sm text-purple-600 mt-1\">\n              {t('band.bandProtocol.ecosystem.nativeIBC')}\n            </p>\n          </div>\n          <div className=\"p-4 bg-purple-50\">\n            <div className=\"flex items-center gap-2 mb-2\">\n              <Database className=\"w-4 h-4 text-purple-700\" />\n              <h4 className=\"font-medium text-purple-900\">\n                {t('band.bandProtocol.ecosystem.dataSources')}\n              </h4>\n            </div>\n            <p className=\"text-2xl font-bold text-purple-700\">200+</p>\n            <p className=\"text-sm text-purple-600 mt-1\">\n              {t('band.bandProtocol.ecosystem.priceFeeds')}\n            </p>\n          </div>\n          <div className=\"p-4 bg-purple-50\">\n            <div className=\"flex items-center gap-2 mb-2\">\n              <Shield className=\"w-4 h-4 text-purple-700\" />\n              <h4 className=\"font-medium text-purple-900\">\n                {t('band.bandProtocol.ecosystem.security')}\n              </h4>\n            </div>\n            <p className=\"text-2xl font-bold text-purple-700\">Tendermint</p>\n            <p className=\"text-sm text-purple-600 mt-1\">\n              {t('band.bandProtocol.ecosystem.bftConsensus')}\n            </p>\n          </div>\n        </div>\n      </DashboardCard>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/panels/CoveragePoolDashboard.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ExternalLink' is defined but never used. Allowed unused vars must match /^_/u.","line":14,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":14,"endColumn":15,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ExternalLink"},"fix":{"range":[164,180],"text":""},"desc":"Remove unused variable \"ExternalLink\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'chartColors' is defined but never used. Allowed unused vars must match /^_/u.","line":22,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":22,"endColumn":21,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"chartColors"},"fix":{"range":[398,449],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'CoveragePoolDashboard' has too many lines (492). Maximum allowed is 50.","line":56,"