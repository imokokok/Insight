y-200\">\n        <h3 className=\"text-sm font-medium text-gray-500 uppercase tracking-wider mb-4\">\n          {t('winklink.tron.integrationStats')}\n        </h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8\">\n          <div>\n            <p className=\"text-xs text-gray-500 uppercase tracking-wider mb-1\">\n              {t('winklink.tron.tvl')}\n            </p>\n            <p className=\"text-2xl font-bold text-gray-900\">\n              ${((tronIntegration?.totalValueLocked || 450000000) / 1e9).toFixed(2)}B\n            </p>\n            <p className=\"text-sm text-emerald-600 mt-1\">+5.2%</p>\n          </div>\n          <div>\n            <p className=\"text-xs text-gray-500 uppercase tracking-wider mb-1\">\n              {t('winklink.tron.integrationCoverage')}\n            </p>\n            <div className=\"flex items-center gap-4\">\n              <div className=\"flex-1\">\n                <div className=\"w-full bg-gray-100 rounded-full h-1.5\">\n                  <div\n                    className=\"bg-pink-500 h-1.5 rounded-full\"\n                    style={{ width: `${(tronIntegration?.integrationCoverage || 0.85) * 100}%` }}\n                  />\n                </div>\n              </div>\n              <span className=\"text-lg font-bold text-gray-900\">\n                {((tronIntegration?.integrationCoverage || 0.85) * 100).toFixed(0)}%\n              </span>\n            </div>\n            <p className=\"text-xs text-gray-500 mt-2\">{dApps.length} dApps integrated</p>\n          </div>\n          <div>\n            <p className=\"text-xs text-gray-500 uppercase tracking-wider mb-1\">\n              {t('winklink.tron.dailyTransactions')}\n            </p>\n            <p className=\"text-2xl font-bold text-gray-900\">\n              {((tronIntegration?.dailyTransactions || 2500000) / 1e6).toFixed(2)}M\n            </p>\n            <p className=\"text-xs text-gray-500 mt-1\">\n              {t('winklink.tron.totalTransactions')}:{' '}\n              {(networkStats?.totalTransactions || 8500000000).toLocaleString()}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* About Section */}\n      <div className=\"pt-6 border-t border-gray-200\">\n        <h3 className=\"text-sm font-medium text-gray-500 uppercase tracking-wider mb-4\">\n          {t('winklink.tron.about')}\n        </h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-sm text-gray-600\">\n          <div>\n            <p className=\"mb-2\">\n              <span className=\"font-medium text-gray-900\">\n                {t('winklink.tron.networkPerformance')}:\n              </span>{' '}\n              {t('winklink.tron.performanceDesc')}\n            </p>\n            <p>\n              <span className=\"font-medium text-gray-900\">{t('winklink.tron.ecosystem')}:</span>{' '}\n              {t('winklink.tron.ecosystemDesc')}\n            </p>\n          </div>\n          <div>\n            <p className=\"mb-2\">\n              <span className=\"font-medium text-gray-900\">\n                {t('winklink.tron.integrationCoverage')}:\n              </span>{' '}\n              {t('winklink.tron.coverageDesc')}\n            </p>\n            <p>\n              <span className=\"font-medium text-gray-900\">\n                {t('winklink.tron.dataReliability')}:\n              </span>{' '}\n              {t('winklink.tron.reliabilityDesc')}\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/