.priceChange.minPrice)}>\n                {comparison.priceChange.minPrice >= 0 ? '+' : ''}$\n                {formatPriceValue(Math.abs(comparison.priceChange.minPrice))}\n              </span>\n            </div>\n          </div>\n\n          <div className=\"bg-gray-50  p-4\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <span className=\"text-xs font-medium text-gray-500 uppercase tracking-wide\">\n                价格范围变化\n              </span>\n              {getChangeIcon(comparison.statsChange.priceRange)}\n            </div>\n            <div className=\"flex items-baseline gap-2\">\n              <span className=\"text-2xl font-bold text-gray-900\">\n                ${formatPriceValue(currentStats.priceRange)}\n              </span>\n              <span\n                className={`text-sm font-medium ${getChangeColor(comparison.statsChange.priceRangePercent, false)}`}\n              >\n                {comparison.statsChange.priceRangePercent >= 0 ? '+' : ''}\n                {comparison.statsChange.priceRangePercent.toFixed(2)}%\n              </span>\n            </div>\n            <div className=\"mt-2 flex items-center justify-between text-xs text-gray-500\">\n              <span>快照范围: ${formatPriceValue(selectedSnapshot.stats.priceRange)}</span>\n              <span className={getChangeColor(comparison.statsChange.priceRange, false)}>\n                {comparison.statsChange.priceRange >= 0 ? '+' : ''}$\n                {formatPriceValue(Math.abs(comparison.statsChange.priceRange))}\n              </span>\n            </div>\n          </div>\n\n          <div className=\"bg-gray-50  p-4\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <span className=\"text-xs font-medium text-gray-500 uppercase tracking-wide\">\n                标准差变化\n              </span>\n              {getChangeIcon(-comparison.statsChange.standardDeviationPercent)}\n            </div>\n            <div className=\"flex items-baseline gap-2\">\n              <span className=\"text-2xl font-bold text-gray-900\">\n                {currentStats.standardDeviationPercent.toFixed(4)}%\n              </span>\n              <span\n                className={`text-sm font-medium ${getChangeColor(-comparison.statsChange.standardDeviationPercent, false)}`}\n              >\n                {comparison.statsChange.standardDeviationPercent >= 0 ? '+' : ''}\n                {comparison.statsChange.standardDeviationPercent.toFixed(4)}%\n              </span>\n            </div>\n            <div className=\"mt-2 flex items-center justify-between text-xs text-gray-500\">\n              <span>快照标准差: {selectedSnapshot.stats.standardDeviationPercent.toFixed(4)}%</span>\n            </div>\n          </div>\n\n          <div className=\"bg-gray-50  p-4\">\n            <div className=\"flex items-center justify-between mb-3\">\n              <span className=\"text-xs font-medium text-gray-500 uppercase tracking-wide\">\n                预言机数量变化\n              </span>\n              {getChangeIcon(comparison.oracleCountChange)}\n            </div>\n            <div className=\"flex items-baseline gap-2\">\n              <span className=\"text-2xl font-bold text-gray-900\">{currentPriceData.length} 个</span>\n              <span\n                className={`text-sm font-medium ${getChangeColor(comparison.oracleCountChange)}`}\n              >\n                {comparison.oracleCountChange >= 0 ? '+' : ''}\n                {comparison.oracleCountChange}\n              </span>\n            </div>\n            <div className=\"mt-2 flex items-center justify-between text-xs text-gray-500\">\n              <span>快照数量: {selectedSnapshot.priceData.length} 个</span>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"mt-6 pt-4 border-t border-gray-200\">\n          <h4 className=\"text-sm font-semibold text-gray-900 mb-3\">预言机价格对比</h4>\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-sm\">\n              <thead>\n                <tr className=\"border-b border-gray-200\">\n                  <th className=\"text-left py-2 px-3 text-xs font-medium text-gray-500 uppercase\">\n                    预言机\n                  </th>\n                  <th className=\"text-right py-2 px-3 text-xs font-medium text-gray-500 uppercase\">\n                    快照价格\n                  </th>\n                  <th className=\"text-right py-2 px-3 text-xs font-medium text-gray-500 uppercase\">\n                    当前价格\n                  </th>\n                  <th className=\"text-right py-2 px-3 text-xs font-medium text-gray-500 uppercase\">\n                    变化\n                  </th>\n                </tr>\n              </thead>\n              <tbody>\n                {selectedSnapshot.priceData.map((snapshotItem) => {\n                  const currentOracle = currentPriceData.find(\n                    (p) => p.provider === snapshotItem.provider\n                  );\n                  const change = currentOracle\n                    ? ((currentOracle.price - snapshotItem.price) / snapshotItem.price) * 100\n                    : null;\n\n                  return (\n                    <tr key={snapshotItem.provider} className=\"border-b border-gray-100\">\n                      <td className=\"py-2 px-3\">\n                        <span className=\"font-medium text-gray-900\">\n                          {oracleNames[snapshotItem.provider]}\n                        </span>\n                      </td>\n                      <td className=\"py-2 px-3 text-right text-gray-600 font-mono\">\n                        ${formatPriceValue(snapshotItem.price)}\n                      </td>\n                      <td className=\"py-2 px-3 text-right text-gray-900 font-mono\">\n                        {currentOracle ? `$${formatPriceValue(currentOracle.price)}` : '-'}\n                      </td>\n                      <td className=\"py-2 px-3 text-right\">\n                        {change !== null ? (\n                          <span className={`font-medium ${getChangeColor(change)}`}>\n                            {change >= 0 ? '+' : ''}\n                            {change.toFixed(2)}%\n                          </span>\n                        ) : (\n                          <span className=\"text-gray-400\">-</span>\n                        )}\n                      </td>\n                    </tr>\n                  );\n                })}\n                {currentPriceData\n                  .filter((p) => !selectedSnapshot.priceData.find((s) => s.provider === p.provider))\n                  .map((currentOracle) => (\n                    <tr\n                      key={currentOracle.provider}\n                      className=\"border-b border-gray-100 bg-success-50\"\n                    >\n                      <td className=\"py-2 px-3\">\n                        <span className=\"font-medium text-gray-900\">\n                          {oracleNames[currentOracle.provider]}\n                        </span>\n                        <span className=\"ml-2 text-xs text-success-600\">(新增)</span>\n                      </td>\n                      <td className=\"py-2 px-3 text-right text-gray-400\">-</td>\n                      <td className=\"py-2 px-3 text-right text-gray-900 font-mono\">\n                        ${formatPriceValue(currentOracle.price)}\n                      </td>\n                      <td className=\"py-2 px-3 text-right\">\n                        <span className=\"text-gray-400\">-</span>\n                      </td>\n                    </tr>\n                  ))}\n              </tbody>\n            </table>\n          </div>\n        </div>\n\n        <div className=\"mt-4 pt-4 border-t border-gray-200\">\n          <div className=\"flex items-center justify-between text-xs text-gray-500\">\n            <span>快照ID: {selectedSnapshot.id}</span>\n            <span>交易对: {selectedSnapshot.symbol}</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/data-display/SnapshotManager.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'SnapshotManager' has too many lines (578). Maximum allowed is 50.","line":51,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":628,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'SnapshotManager' has a complexity of 12. Maximum allowed is 10.","line":51,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":51,"endColumn":32},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadSnapshots'. Either include it or remove the dependency array.","line":86,"column":6,"nodeType":"ArrayExpression","endLine":86,"endColumn":12,"suggestions":[{"desc":"Update the dependencies array to be: [loadSnapshots, user]","fix":{"range":[2728,2734],"text":"[loadSnapshots, user]"}}]},{"ruleId":"max-lines-per-function","severity":2,"message":"Arrow function has too many lines (191). Maximum allowed is 50.","line":326,"column":32,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":516,"endColumn":18},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (597). Maximum allowed is 500.","line":530,"column":1,"nodeType":null,"messageId":"exceed","endLine":629,"endColumn":1}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { useState, useEffect, useCallback, useRef } from 'react';\n\nimport { useTranslations } from '@/i18n';\nimport {\n  getSnapshotsFromDatabase,\n  deleteSnapshotFromDatabase,\n  shareSnapshot,\n  unshareSnapshot,\n  getSnapshotShareStatus,\n  getSnapshotsFromLocalStorage,\n  deleteSnapshotFromLocalStorage,\n  clearAllLocalStorageSnapshots,\n  detectLocalStorageSnapshots,\n  migrateSnapshotsToDatabase,\n  clearLocalStorageSnapshots,\n  markMigrationComplete,\n} from '@/lib/snapshots';\nimport { createLogger } from '@/lib/utils/logger';\nimport { useUser } from '@/stores/authStore';\nimport { formatTimestamp, getTimeAgo } from '@/types/common/timestamps';\nimport type { OracleSnapshot } from '@/types/oracle';\nimport { OracleProvider } from '@/types/oracle';\n\nconst logger = createLogger('SnapshotManager');\n\nconst oracleNames: Record<OracleProvider, string> = {\n  [OracleProvider.CHAINLINK]: 'Chainlink',\n  [OracleProvider.BAND_PROTOCOL]: 'Band Protocol',\n  [OracleProvider.UMA]: 'UMA',\n  [OracleProvider.PYTH]: 'Pyth',\n  [OracleProvider.API3]: 'API3',\n  [OracleProvider.REDSTONE]: 'RedStone',\n  [OracleProvider.DIA]: 'DIA',\n  [OracleProvider.TELLOR]: 'Tellor',\n  [OracleProvider.CHRONICLE]: 'Chronicle',\n  [OracleProvider.WINKLINK]: 'WINkLink',\n};\n\ninterface SnapshotManagerProps {\n  onSaveSnapshot?: () => void;\n  onSelectSnapshot?: (snapshot: OracleSnapshot) => void;\n  selectedSnapshotId?: string | null;\n}\n\ninterface ShareState {\n  [key: string]: boolean;\n}\n\nexport function SnapshotManager({\n  onSaveSnapshot,\n  onSelectSnapshot,\n  selectedSnapshotId,\n}: SnapshotManagerProps) {\n  const user = useUser();\n  const t = useTranslations();\n  const [snapshots, setSnapshots] = useState<OracleSnapshot[]>([]);\n  const [isExpanded, setIsExpanded] = useState(false);\n  const [showDeleteConfirm, setShowDeleteConfirm] = useState<string | null>(null);\n  c