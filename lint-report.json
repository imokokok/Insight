ame=\"py-2 px-3 text-sm text-gray-900\">{validator.name}</td>\n                        <td className=\"py-2 px-3 text-sm text-right text-gray-900\">\n                          {validator.responseTime}ms\n                        </td>\n                        <td className=\"py-2 px-3 text-sm text-right text-gray-900\">\n                          {validator.successRate}%\n                        </td>\n                        <td className=\"py-2 px-3 text-sm text-right text-gray-900\">\n                          {validator.reputation}\n                        </td>\n                        <td className=\"py-2 px-3 text-sm text-right font-semibold text-success-600\">\n                          {formatNumber(validator.earnings)}\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            </DashboardCard>\n          </div>\n        </>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/charts/ValidatorGeographicMap.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'ValidatorGeographicMap' has too many lines (275). Maximum allowed is 50.","line":120,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":394,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { useState, useMemo, useCallback } from 'react';\n\nimport { Globe, MapPin, Users, Coins 