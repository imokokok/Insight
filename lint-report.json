er-gray-200\" />\n\n      <section className=\"flex items-center justify-between py-2\">\n        <div className=\"flex items-center gap-2 text-sm text-gray-500\">\n          <ExternalLink className=\"w-4 h-4\" />\n          <span>{t('redstone.arweave.learnMore') || 'Learn more about'}</span>\n          <a\n            href=\"https://www.arweave.org/\"\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"text-red-500 hover:text-red-600 font-medium\"\n          >\n            Arweave\n          </a>\n        </div>\n        <div className=\"text-xs text-gray-400\">\n          {t('redstone.arweave.lastUpdated') || 'Last updated'}: {new Date().toLocaleString()}\n        </div>\n      </section>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/redstone/components/RedStoneCrossChainView.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ChainInfo' is defined but never used. Allowed unused vars must match /^_/u.","line":10,"column":49,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":58,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ChainInfo"},"fix":{"range":[386,402],"text":""},"desc":"Remove unused variable \"ChainInfo\"."}]},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'RedStoneCrossChainView' has too many lines (168). Maximum allowed is 50.","line":12,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":179,"endColumn":2},{"ruleId":"max-lines-per-function","severity":2,"message":"Arrow function has too many lines (51). Maximum allowed is 50.","line":122,"column":36,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":172,"endColumn":16}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { Link, Zap, Trophy, Activity, Server } from 'lucide-react';\n\nimport { useRedStoneSupportedChains } from '@/hooks/oracles/redstone';\nimport { useTranslations } from '@/i18n';\nimport { REDSTONE_SUPPORTED_CHAINS } from '@/lib/oracles/redstoneConstants';\n\nimport { useRedStoneClient } from '../context/RedStoneClientContext';\nimport { type RedStoneCrossChainViewProps, type ChainInfo } from '../types';\n\nexport function RedStoneCrossChainView({ isLoading }: RedStoneCrossChainViewProps) {\n  const t = useTranslations();\n  const client = useRedStoneClient();\n  const { chains, isLoading: chainsLoading } = useRedStoneSupportedChains(client, !isLoading);\n\n  const supportedChains = chains.length > 0 ? chains : REDSTONE_SUPPORTED_CHAINS;\n  const showLoading = isLoading || chainsLoading;\n\n  const avgLatency = Math.round(\n    supportedChains.reduce((sum, c) => sum + c.latency, 0) / supportedChains.length\n  );\n  const fastestChain = supportedChains.reduce((min, c) => (c.latency < min.latency ? c : min));\n  const maxLatency = Math.max(...supportedChains.map((c) => c.latency));\n\n  const stats = [\n    {\n      title: t('redstone.crossChain.supportedChains'),\n      value: String(supportedChains.length),\n      change: '+2',\n      changeType: 'positive' as const,\n      icon: Link,\n    },\n    {\n      title: t('redstone.stats.avgResponse'),\n      value: `${avgLatency}ms`,\n      change: '-5ms',\n      changeType: 'positive' as const,\n      icon: Zap,\n    },\n    {\n      title: t('redstone.crossChain.fastestChain'),\n      value: fastestChain.chain,\n      change: `${fastestChain.latency}ms`,\n      changeType: 'neutral' as const,\n      icon: Trophy,\n    },\n    {\n      title: t('redstone.crossChain.uptime'),\n      value: '99.9%',\n      change: '+0.01%',\n      changeType: 'positive' as const,\n      icon: Activity,\n    },\n  ];\n\n  return (\n    <div className=\"space-y-8\">\n      <div className=\"flex flex-wrap items-center gap-6 p-4 bg-white border border-gray-200 rounded-lg\">\n        {stats.map((stat, index) => {\n          const IconComponent = stat.icon;\n          return (\n            <div key={index} className=\"flex items-center gap-3\">\n              <div className=\"flex items-center justify-center w-10 h-10 bg-red-50 rounded-md\">\n                <IconComponent className=\"w-5 h-5 text-red-500\" />\n              </div>\n              <div>\n                <p className=\"text-xs text-gray-500\">{stat.title}</p>\n                <div className=\"flex items-center gap-2\">\n                  <p className=\"text-lg font-bold text-gray-900\">\n                    {showLoading ? '-' : stat.value}\n                  </p>\n                  <span\n                    className={`text-xs font-medium ${\n                      stat.changeType === 'positive' ? 'text-emerald-600' : 'text-gray-500'\n                    }`}\n                  >\n                    {stat.changeType === 'positive' ? '↑' : '→'} {stat.change}\n                  </span>\n                </div>\n              </div>\n              {index < stats.length - 1 && (\n                <div className=\"hidden sm:block w-px h-10 bg-gray-200 ml-3\" />\n              )}\n            </div>\n          );\n        })}\n      </div>\n\n      <div className=\"bg-white border border-gray-200 rounded-lg overflow-hidden\">\n        <div className=\"px-4 py-3 border-b border-gray-200 bg-gray-50\">\n          <div className=\"flex items-center gap-2\">\n            <Server className=\"w-4 h-4 text-gray-500\" />\n            <h3 className=\"text-sm font-semibold text-gray-900\">\n              {t('redstone.crossChain.ch