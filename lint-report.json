                      <div key={idx}>\n                        <p className=\"text-xs text-gray-500\">{metric.label}</p>\n                        <p className=\"text-lg font-semibold text-gray-900\">{metric.value}</p>\n                        {metric.subValue && (\n                          <p className=\"text-xs text-emerald-600\">{metric.subValue}</p>\n                        )}\n                      </div>\n                    ))}\n                  </div>\n\n                  <div className=\"pt-3 border-t border-gray-200/50\">\n                    <p className=\"text-xs text-gray-500 mb-2\">\n                      {t('chainlink.network.components')}\n                    </p>\n                    <div className=\"space-y-1.5\">\n                      {layer.nodes.map((node, idx) => (\n                        <div key={idx} className=\"flex items-center justify-between text-sm\">\n                          <div className=\"flex items-center gap-2\">\n                            <div\n                              className={cn('w-2 h-2 rounded-full', getStatusColor(node.status))}\n                            />\n                            <span className=\"text-gray-700\">{node.name}</span>\n                          </div>\n                          {node.count && (\n                            <span className=\"text-gray-500 text-xs\">\n                              {node.count.toLocaleString()}\n                            </span>\n                          )}\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n\n                {index < layers.length - 1 && (\n                  <>\n                    <div className=\"hidden md:flex absolute top-1/2 -right-2 transform -translate-y-1/2 z-10\">\n                      <div className=\"bg-white border border-gray-200 rounded-full p-1 shadow-sm\">\n                        <ArrowRight className=\"w-4 h-4 text-gray-400\" />\n                      </div>\n                    </div>\n                    <div className=\"flex md:hidden justify-center py-2\">\n                      <div className=\"bg-white border border-gray-200 rounded-full p-1 shadow-sm\">\n                        <ArrowRight className=\"w-4 h-4 text-gray-400 rotate-90\" />\n                      </div>\n                    </div>\n                  </>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n\n        <div className=\"pt-3 border-t border-gray-100\">\n          <div className=\"flex flex-wrap items-center justify-between gap-3\">\n            <div className=\"flex items-center gap-4 text-xs text-gray-500\">\n              <div className=\"flex items-center gap-1.5\">\n                <div className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n                <span>{t('chainlink.network.healthy')}</span>\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <div className=\"w-2 h-2 rounded-full bg-amber-500\" />\n                <span>{t('chainlink.network.warning')}</span>\n              </div>\n              <div className=\"flex items-center gap-1.5\">\n                <div className=\"w-2 h-2 rounded-full bg-red-500\" />\n                <span>{t('chainlink.network.critical')}</span>\n              </div>\n            </div>\n            <div className=\"text-xs text-gray-500\">\n              {t('chainlink.network.dataFlow')}: {t('chainlink.network.sourcesToConsumers')}\n            </div>\n          </div>\n        </div>\n      </div>\n    </DashboardCard>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-e