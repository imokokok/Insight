00 bg-gray-100'\n                : 'text-gray-500 hover:text-gray-700 hover:bg-gray-50'\n            }`}\n          >\n            {category.label}\n            <span\n              className={`text-xs ${\n                selectedCategory === category.id ? 'text-gray-600' : 'text-gray-400'\n              }`}\n            >\n              {category.count}\n            </span>\n          </button>\n        ))}\n      </div>\n\n      {/* Data Sources Table */}\n      <div>\n        <h3 className=\"text-sm font-medium text-gray-500 uppercase tracking-wider mb-4\">\n          {t('winklink.gaming.dataSources')}\n        </h3>\n        <WinklinkDataTable\n          data={filteredDataSources as Record<string, unknown>[]}\n          columns={\n            dataSourceColumns as Array<{\n              key: string;\n              header: string;\n              width?: string;\n              sortable?: boolean;\n              render?: (item: Record<string, unknown>) => React.ReactNode;\n            }>\n          }\n          isLoading={isLoading}\n        />\n      </div>\n\n      {/* VRF Services Table */}\n      <div className=\"pt-6 border-t border-gray-200\">\n        <h3 className=\"text-sm font-medium text-gray-500 uppercase tracking-wider mb-4\">\n          {t('winklink.gaming.randomNumberServices')}\n        </h3>\n        <WinklinkDataTable\n          data={gamingData.randomNumberServices as Record<string, unknown>[]}\n          columns={\n            vrfColumns as Array<{\n              key: string;\n              header: string;\n              width?: string;\n              sortable?: boolean;\n              render?: (item: Record<string, unknown>) => React.ReactNode;\n            }>\n          }\n          isLoading={isLoading}\n        />\n      </div>\n\n      {/* Use Cases - Compact Layout */}\n      <div className=\"pt-6 border-t border-gray-200\">\n        <h3 className=\"text-sm font-medium text-gray-500 uppercase tracking-wider mb-4\">\n          {t('winklink.gaming.vrfUseCases')}\n        </h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          {VRF_USE_CASES.map((useCase) => (\n            <div\n              key={useCase.id}\n              className=\"flex items-start gap-3 p-3 border-b border-gray-100 last:border-0\"\n            >\n              <div className=\"flex-shrink-0 w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center\">\n                <Zap className=\"w-4 h-4 text-pink-600\" />\n              </div>\n              <div className=\"flex-1 min-w-0\">\n                <div className=\"flex items-center justify-between\">\n                  <h4 className=\"text-sm font-medium text-gray-900\">{useCase.name}</h4>\n                  <span className=\"text-xs text-gray-500\">{useCase.category}</span>\n                </div>\n                <p className=\"text-xs text-gray-600 mt-1\">{useCase.description}</p>\n                <div className=\"flex items-center gap-4 mt-2 text-xs\">\n                  <span className=\"text-gray-500\">\n                    Usage:{' '}\n                    <span className=\"font-medium text-gray-900\">\n                      {(useCase.usageCount / 1e6).toFixed(1)}M\n                    </span>\n                  </span>\n                  <span className=\"text-gray-500\">\n                    Reliability:{' '}\n                    <span className=\"font-medium text-emerald-600\">{useCase.reliability}%</span>\n                  </span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* About Section */}\n      <div className=\"pt-6 border-t border-gray-200\">\n        <h3 className=\"text-sm font-medium text-gray-500 uppercase tracking-wider mb-4\">\n          {t('winklink.gaming.about')}\n        </h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-sm text-gray-600\">\n          <div>\n            <p className=\"mb-2\">\n              <span className=\"font-medium text-gray-900\">{t('winklink.gaming.vrfTitle')}:</span>{' '}\n              {t('winklink.gaming.vrfDesc')}\n            </p>\n            <p>\n              <span className=\"font-medium text-gray-900\">\n                {t('winklink.gaming.securityTitle')}:\n              </span>{' '}\n              {t('winklink.gaming.securityDesc')}\n            </p>\n          </div>\n          <div>\n            <p className=\"mb-2\">\n              <span className=\"font-medium text-gray-900\">\n                {t('winklink.gaming.responseTitle')}:\n              </span>{' '}\n              {t('winklink.gaming.responseDesc')}\n            </p>\n            <p>\n              <span className=\"font-medium text-gray-900\">\n                {t('winklink.gaming.multiChainTitle')}:\n              </span>{' '}\n              {t('winklink.gaming.multiChainDesc')}\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/winklink/components/WinklinkHero.tsx","messages":[{"ruleId":"complexity","severity":2,"message":"Function 'Sparkline' has a complexity of 11. Maximum allowed is 10.","line":65,"column":1,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":65,"endColumn":19},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'EnhancedCoreStats' has too many lines (56). Maximum allowed is 50.","line":115,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":170,"endColumn":2},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'MiniPriceChart' has too many lines (51). Maximum allowed is 50.","line":173,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":223,"endColumn":2},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'themeColor' is defined but never used. Allowed unused args must match /^_/u.","line":176,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":176,"endColumn":13},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'i' is defined but never used. Allowed unused args must match /^_/u.","line":190,"column":43,"nodeType":"Identifier","messageId":"unusedVar","endLine":190,"endColumn":44},{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\n/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/winklink/components/WinklinkHero.tsx:190:67\n  188 |     // 生成模拟数据\n  189 |     const basePrice = currentPrice?.price || 0.00012;\n> 190 |     return Array.from({ length: 20 }, (_, i) => basePrice * (1 + (Math.random() - 0.5) * 0.1));\n      |                                                                   ^^^^^^^^^^^^^ Cannot call impure function\n  191 |   }, [historicalData, currentPrice]);\n  192 |\n  193 |   const priceChange = useMemo(() => {","line":190,"column":67,"nodeType":null,"endLine":190,"endColumn":80},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'UnifiedInfoSection' has too many lines (158). Maximum allowed is 50.","line":306,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":463,"endColumn":2},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'themeColor' is defined but never used. Allowed unused args must match /^_/u.","line":466,"column":25,"nodeType":"Identifier","messageId":"unusedVar","endLine":466,"endColumn":35},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'LatestUpdates' has too many lines (57). Maximum allowed is 50.","line":496,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":552,"endColumn":2},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'themeColor' is defined but never used. Allowed unused args must match /^_/u.","line":496,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":496,"endColumn":36},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'WinklinkHero' has too many lines (270). Maximum allowed is 50.","line":554,"column":16,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":823,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'WinklinkHero' has a complexity of 14. Maximum allowed is 10.","line":554,"column":16,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":554,"endColumn":37},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (742). Maximum allowed is 500.","line":556,"column":1,"nodeType":null,"messageId":"exceed","endLine":824,"endColumn":1},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'isLoading' is defined but never used. Allowed unused args must match /^_/u.","line":559,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":559,"endColumn":12},{"ruleId":"react-hooks/static-components","severity":2,"message":"Error: Cannot create components during render\n\nComponents created during render will reset their state each time they are created. Declare components outside of render.\n\n/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/winklink/components/WinklinkHero.tsx:750:25\n  748 |           <QuickActions themeColor={themeColor} />\n  749 |         </div>\n> 750 |         {dataStates && <DataStatusIndicator />}\n      |                         ^^^^^^^^^^^^^^^^^^^ This component is created during render\n  751 |       </div>\n  752 |\n  753 |       {/* 主要内容区 - 桌面端左右分栏布局 */}\n\n/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/winklink/components/WinklinkHero.tsx:598:31\n  596 |   };\n  597 |\n> 598 |   const DataStatusIndicator = () => {\n      |                               ^^^^^^^\n> 599 |     if (!dataStates) return null;\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 600 |\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 638 |     );\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 639 |   };\n      | ^^^^ The component is created during render here\n  640 |\n  641 |   // 生成价格走势数据\n  642 |   const priceSparkline = useMemo(() => {","line":750,"column":25,"nodeType":null,"endLine":750,"endColumn":44}],"suppressedMessages":[],"errorCount":10,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { useMemo } from 'react';\n\nimport {\n  TrendingUp,\n  TrendingDown,\n  Activity,\n  Globe,\n  Database,\n  Wallet,\n  Zap,\n  Shield,\n  Bell,\n  FileText,\n  Layers,\n  RefreshCw,\n  ExternalLink,\n  Plus,\n  Gamepad2,\n  Cpu,\n  Clock,\n  Server,\n  TrendingUp as TrendingUpIcon,\n} from 'lucide-react';\n\nimport { OptimizedImage } from '@/components/performance/OptimizedImage';\nimport { LiveStatusBar } from '@/components/ui';\nimport { useTranslations } from '@/i18n';\nimport { type OracleConfig } from '@/lib/config/oracles';\nimport { type PriceData } from '@/types/oracle';\n\ninterface WinklinkHeroProps {\n  config: OracleConfig;\n  price: PriceData | null;\n  historicalData: PriceData[];\n  networkStats?: {\n    avgResponseTime: number;\n    nodeUptime: number;\n    dataFeeds: number;\n  };\n  isLoading: boolean;\n  isError: boolean;\n  isRefreshing: boolean;\n  lastUpdated: Date | null;\n  dataStates?: Record<string, { isLoading: boolean; isError: boolean; lastUpdated: Date | null }>;\n  failedDataSources?: string[];\n  loadingDataSources?: string[];\n\n  onRefresh: () => void;\n  onExport: () => void;\n}\n\ninterface StatItem {\n  title: string;\n  value: string;\n  change?: string;\n  changeType: 'positive' | 'negative' | 'neutral';\n  icon: React.ReactNode;\n  subtitle?: string;\n  sparklineData?: number[];\n}\n\n// 迷你走势图组件\nfunction Sparkline({\n  data,\n  positive,\n  width = 60,\n  height = 24,\n}: {\n  data: number[];\n  positive: boolean;\n  width?: number;\n  height?: number;\n}) {\n  if (!data || data.length < 2) return null;\n\n  const min = Math.min(...data);\n  const max = Math.max(...data);\n  const range = max - min || 1;\n\n  const points = data\n    .map((value, index) => {\n      const x = (index / (data.length - 1)) * width;\n      const y = height - ((value - min) / range) * height * 0.8 - height * 0.1;\n      return `${x},${y}`;\n    })\n    .join(' ');\n\n  return (\n    <svg width={width} height={height} className=\"overflow-visible\">\n      <defs>\n        <linearGradient id={`gradient-${positive ? 'up' : 'down'}`} x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n          <stop offset=\"0%\" stopColor={positive ? '#10b981' : '#ef4444'} stopOpacity=\"0.3\" />\n          <stop offset=\"100%\" stopColor={positive ? '#10b981' : '#ef4444'} stopOpacity=\"0\" />\n        </linearGradient>\n      </defs>\n      <polygon\n        points={`0,${height} ${points} ${width},${height}`}\n        fill={`url(#gradient-${positive ? 'up' : 'down'})`}\n      />\n      <polyline\n        fill=\"none\"\n        stroke={positive ? '#10b981' : '#ef4444'}\n        strokeWidth=\"2\"\n        strokeLinecap=\"round\"\n        strokeLinejoin=\"round\"\n        points={points}\n      />\n    </svg>\n  );\n}\n\n// 增强版核心统计组件 - 5个指标，响应式网格布局\nfunction EnhancedCoreStats({ stats, themeColor }: { stats: StatItem[]; themeColor: string }) {\n  // 取前5个指标\n  const displayStats = stats.slice(0, 5);\n\n  return (\n    <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3\">\n      {displayStats.map((stat, index) => {\n        const isPositive = stat.changeType === 'positive';\n        const isNegative = stat.changeType === 'negative';\n\n        return (\n          <div\n            key={index}\n            className=\"relative p-3 rounded-xl bg-gray-50/50 border border-gray-100 hover:border-gray-200 hover:bg-gray-50 transition-all group\"\n          >\n            <div className=\"flex items-start justify-between mb-2\">\n              <div className=\"p-2 rounded-lg\" style={{ backgroundColor: `${themeColor}15` }}>\n                <div style={{ color: themeColor }} className=\"w-4 h-4\">\n                  {stat.icon}\n                </div>\n              </div>\n              {stat.sparklineData && (\n                <div className=\"opacity-60 group-hover:opacity-100 transition-opacity\">\n                  <Sparkline\n                    data={stat.sparklineData}\n                    positive={isPositive}\n                    width={50}\n                    height={20}\n                  />\n                </div>\n              )}\n            </div>\n            <div className=\"text-xs text-gray-500 mb-1\">{stat.title}</div>\n            <div className=\"text-lg font-bold text-gray-900 tracking-tight\">{stat.value}</div>\n            {stat.change && (\n              <div className=\"flex items-center gap-1 mt-1\">\n                <span\n                  className={`text-xs font-medium flex items-center gap-0.5 ${\n                    isPositive ? 'text-emerald-600' : isNegative ? 'text-red-600' : 'text-gray-500'\n                  }`}\n                >\n                  {isPositive && <TrendingUp className=\"w-3 h-3\" />}\n                  {isNegative && <TrendingDown className=\"w-3 h-3\" />}\n                  {stat.change}\n                </span>\n                {stat.subtitle && (\n                  <span className=\"text-[10px] text-gray-400\">{stat.subtitle}</span>\n                )}\n              </div>\n            )}\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\n// 右侧迷你价格图表组件\nfunction MiniPriceChart({\n  historicalData,\n  currentPrice,\n  themeColor,\n}: {\n  historicalData: PriceData[];\n  currentPrice: PriceData | null;\n  themeColor: string;\n}) {\n  const t = useTranslations();\n\n  const chartData = useMemo(() => {\n    if (historicalData.length >= 20) {\n      return historicalData.slice(-20).map((d) => d.price);\n    }\n    // 生成模拟数据\n    const basePrice = currentPrice?.price || 0.00012;\n    return Array.from({ length: 20 }, (_, i) => basePrice * (1 + (Math.random() - 0.5) * 0.1));\n  }, [historicalData, currentPrice]);\n\n  const priceChange = useMemo(() => {\n    if (chartData.length < 2) return 0;\n    return ((chartData[chartData.length - 1] - chartData[0]) / chartData[0]) * 100;\n  }, [chartData]);\n\n  const isPositive = priceChange >= 0;\n\n  if (!chartData.length) return null;\n\n  return (\n    <div className=\"h-full flex flex-col\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <div className=\"flex items-center gap-1.5 text-xs text-gray-500\">\n          <TrendingUpIcon className=\"w-3.5 h-3.5\" />\n          <span>{t('winklink.hero.priceTrend24h')}</span>\n        </div>\n        <span className={`text-xs font-medium ${isPositive ? 'text-emerald-600' : 'text-red-600'}`}>\n          {isPositive ? '+' : ''}\n          {priceChange.toFixed(2)}%\n        </span>\n      </div>\n      <div className=\"flex-1 min-h-[80px] flex items-end\">\n        <Sparkline data={chartData} positive={isPositive} width={180} height={70} />\n      </div>\n      <div className=\"flex justify-between mt-2 text-[10px] text-gray-400\">\n        <span>{t('winklink.hero.hoursAgo24')}</span>\n        <span>{t('winklink.hero.now')}</span>\n      </div>\n    </div>\n  );\n}\n\n// 操作按钮组件\nfunction ActionButtons({\n  onRefresh,\n  onExport,\n  isRefreshing,\n  themeColor,\n}: {\n  onRefresh: () => void;\n  onExport: () => void;\n  isRefreshing: boolean;\n  themeColor: string;\n}) {\n  const t = useTranslations();\n\n  return (\n    <div className=\"flex items-center gap-2\">\n      <button\n        onClick={onRefresh}\n        disabled={isRefreshing}\n        className=\"flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 hover:border-gray-300 disabled:opacity-50 transition-all\"\n      >\n        <RefreshCw className={`w-3.5 h-3.5 ${isRefreshing ? 'animate-spin' : ''}`} />\n        <span className=\"hidden sm:inline\">{t('common.refresh')}</span>\n      </button>\n      <button\n        onClick={onExport}\n        className=\"flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-white rounded-lg hover:opacity-90 transition-all shadow-sm\"\n        style={{ backgroundColor: themeColor }}\n      >\n        <ExternalLink className=\"w-3.5 h-3.5\" />\n        <span className=\"hidden sm:inline\">{t('common.export')}</span>\n      </button>\n    </div>\n  );\n}\n\n// 整合的次要指标行 - 4个指标在一行展示，纯文本+图标，无卡片背景，用分隔符区分\nfunction CompactMetricsRow({ stats }: { stats: StatItem[] }) {\n  // 只取前4个次要指标\n  const displayStats = stats.slice(0, 4);\n\n  return (\n    <div className=\"flex flex-wrap items-center gap-y-2 py-2\">\n      {displayStats.map((stat, index) => {\n        const isPositive = stat.changeType === 'positive';\n        const isNegative = stat.changeType === 'negative';\n        const isLast = index === displayStats.length - 1;\n\n        return (\n          <div key={index} className=\"flex items-center\">\n            <div className=\"flex items-center gap-1.5 px-3 first:pl-0\">\n              <div className=\"text-gray-400\">{stat.icon}</div>\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"text-xs text-gray-500\">{stat.title}</span>\n                <span className=\"text-xs font-semibold text-gray-900\">{stat.value}</span>\n                {stat.change && (\n                  <span\n                    className={`text-[10px] font-medium flex items-center gap-0.5 ${\n                      isPositive\n                        ? 'text-emerald-600'\n                        : isNegative\n                          ? 'text-red-600'\n                          : 'text-gray-500'\n                    }`}\n                  >\n                    {isPositive && <TrendingUp className=\"w-2.5 h-2.5\" />}\n                    {isNegative && <TrendingDown className=\"w-2.5 h-2.5\" />}\n                    {stat.change}\n                  </span>\n                )}\n              </div>\n            </div>\n            {!isLast && <div className=\"w-px h-3 bg-gray-200\" />}\n          </div>\n        );\n      })}\n    </div>\n  );\n}\n\n// 整合的信息区 - 链上指标、网络健康度、多链支持整合为紧凑形式\nfunction UnifiedInfoSection({\n  networkStats,\n  healthScore,\n  chains,\n  themeColor,\n}: {\n  networkStats?: {\n    avgResponseTime: number;\n    nodeUptime: number;\n    dataFeeds: number;\n  };\n  healthScore: number;\n  chains: string[];\n  themeColor: string;\n}) {\n  const t = useTranslations();\n\n  const getHealthColor = () => {\n    if (healthScore >= 90) return 'text-emerald-600';\n    if (healthScore >= 70) return 'text-yellow-600';\n    return 'text-red-600';\n  };\n\n  const getHealthBgColor = () => {\n    if (healthScore >= 90) return 'bg-emerald-500';\n    if (healthScore >= 70) return 'bg-yellow-500';\n    return 'bg-red-500';\n  };\n\n  const gasLevel = useMemo(() => {\n    if (!networkStats)\n      return {\n        label: t('winklink.hero.gasMedium'),\n        color: 'text-yellow-600',\n        bg: 'bg-yellow-500',\n        width: '50%',\n      };\n    const { avgResponseTime } = networkStats;\n    if (avgResponseTime < 150)\n      return {\n        label: t('winklink.hero.gasLow'),\n        color: 'text-emerald-600',\n        bg: 'bg-emerald-500',\n        width: '30%',\n      };\n    if (avgResponseTime < 300)\n      return {\n        label: t('winklink.hero.gasMedium'),\n        color: 'text-yellow-600',\n        bg: 'bg-yellow-500',\n        width: '50%',\n      };\n    return {\n      label: t('winklink.hero.gasHigh'),\n      color: 'text-red-600',\n      bg: 'bg-red-500',\n      width: '80%',\n    };\n  }, [networkStats, t]);\n\n  // 只显示前3个链\n  const displayChains = chains.slice(0, 3);\n  const remainingCount = Math.max(0, chains.length - 3);\n\n  return (\n    <div className=\"flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-4 py-3 border-t border-gray-100\">\n      {/* 网络健康度 - 进度条+数字紧凑形式 */}\n      <div className=\"flex items-center gap-2 min-w-[120px]\">\n        <div className=\"flex items-center gap-1 text-xs text-gray-500\">\n          <Activity className=\"w-3.5 h-3.5\" />\n          <span>{t('winklink.hero.health')}</span>\n        </div>\n        <div className=\"flex items-center gap-1.5\">\n          <div className=\"w-12 h-1 bg-gray-200 rounded-full overflow-hidden\">\n            <div\n              className={`h-full rounded-full ${getHealthBgColor()}`}\n              style={{ width: `${healthScore}%` }}\n            />\n          </div>\n          <span className={`text-xs font-semibold ${getHealthColor()}`}>{healthScore}</span>\n        </div>\n      </div>\n\n      {/* 分隔符 */}\n      <div className=\"hidden sm:block w-px h-4 bg-gray-200\" />\n\n      {/* 链上指标 - 紧凑展示 */}\n      {networkStats && (\n        <div className=\"flex items-center gap-3\">\n          {/* Gas 费水平 */}\n          <div className=\"flex items-center gap-1.5\">\n            <div className=\"flex items-center gap-1 text-xs text-gray-500\">\n              <Zap className=\"w-3.5 h-3.5\" />\n              <span>{t('winklink.hero.gas')}</span>\n            </div>\n            <div className=\"flex items-center gap-1\">\n              <div className=\"w-10 h-1 bg-gray-200 rounded-full overflow-hidden\">\n                <div\n                  className={`h-full rounded-full ${gasLevel.bg}`}\n                  style={{ width: gasLevel.width }}\n                />\n              </div>\n              <span className={`text-[10px] font-medium ${gasLevel.color}`}>{gasLevel.label}</span>\n            </div>\n          </div>\n\n          {/* 响应时间 */}\n          <div className=\"flex items-center gap-1\">\n            <Clock className=\"w-3.5 h-3.5 text-gray-400\" />\n            <span className=\"text-xs text-gray-500\">{t('winklink.hero.response')}</span>\n            <span className=\"text-xs font-medium text-gray-900\">\n              {networkStats.avgResponseTime}ms\n            </span>\n          </div>\n\n          {/* 节点在线率 */}\n          <div className=\"flex items-center gap-1\">\n            <Server className=\"w-3.5 h-3.5 text-gray-400\" />\n            <span className=\"text-xs text-gray-500\">{t('winklink.hero.online')}</span>\n            <span className=\"text-xs font-medium text-gray-900\">{networkStats.nodeUptime}%</span>\n          </div>\n        </div>\n      )}\n\n      {/* 分隔符 */}\n      <div className=\"hidden sm:block w-px h-4 bg-gray-200\" />\n\n      {/* 多链支持 - 只显示链数量+前3个链图标 */}\n      <div className=\"flex items-center gap-2\">\n        <div className=\"flex items-center gap-1 text-xs text-gray-500\">\n          <Globe className=\"w-3.5 h-3.5\" />\n          <span>{t('winklink.hero.support')}</span>\n        </div>\n        <div className=\"flex items-center gap-1.5\">\n          {/* 链数量 */}\n          <span className=\"text-xs font-semibold\" style={{ color: themeColor }}>\n            {chains.length}+ {t('winklink.hero.chains')}\n          </span>\n          {/* 前3个链图标 */}\n          <div className=\"flex -space-x-1\">\n            {displayChains.map((chain, index) => (\n              <div\n                key={index}\n                className=\"w-5 h-5 rounded-full bg-gray-100 border border-white flex items-center justify-center text-[8px] font-medium text-gray-600\"\n                title={chain}\n              >\n                {chain.slice(0, 2).toUpperCase()}\n              </div>\n            ))}\n          </div>\n          {remainingCount > 0 && (\n            <span className=\"text-[10px] text-gray-400\">+{remainingCount}</span>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n}\n\n// 快速操作组件\nfunction QuickActions({ themeColor }: { themeColor: string }) {\n  const t = useTranslations();\n\n  const actions = [\n    { icon: <Bell className=\"w-3.5 h-3.5\" />, label: t('winklink.hero.priceAlert'), href: '#' },\n    { icon: <Plus className=\"w-3.5 h-3.5\" />, label: t('winklink.hero.addMonitor'), href: '#' },\n    { icon: <FileText className=\"w-3.5 h-3.5\" />, label: t('winklink.hero.apiDocs'), href: '#' },\n    {\n      icon: <Layers className=\"w-3.5 h-3.5\" />,\n      label: t('winklink.hero.switchNetwork'),\n      href: '#',\n    },\n  ];\n\n  return (\n    <div className=\"flex flex-wrap gap-1.5\">\n      {actions.map((action, index) => (\n        <button\n          key={index}\n          className=\"flex items-center gap-1 px-2 py-1 bg-white border border-gray-200 rounded text-[11px] text-gray-700 hover:border-gray-300 hover:shadow-sm transition-all\"\n        >\n          {action.icon}\n          <span>{action.label}</span>\n        </button>\n      ))}\n    </div>\n  );\n}\n\n// 最新动态滚动条\nfunction LatestUpdates({ themeColor }: { themeColor: string }) {\n  const t = useTranslations();\n\n  const updates = [\n    {\n      type: 'price',\n      text: t('winklink.hero.updatePrice'),\n      time: t('winklink.hero.minutesAgo', { count: 2 }),\n    },\n    {\n      type: 'node',\n      text: t('winklink.hero.updateNode'),\n      time: t('winklink.hero.minutesAgo', { count: 5 }),\n    },\n    {\n      type: 'feed',\n      text: t('winklink.hero.updateFeed'),\n      time: t('winklink.hero.minutesAgo', { count: 8 }),\n    },\n    {\n      type: 'system',\n      text: t('winklink.hero.updateSystem'),\n      time: t('winklink.hero.minutesAgo', { count: 15 }),\n    },\n  ];\n\n  return (\n    <div className=\"bg-gray-50 border-t border-gray-200 py-2 px-4\">\n      <div className=\"max-w-[1600px] mx-auto flex items-center gap-4 overflow-hidden\">\n        <span className=\"text-xs font-medium text-gray-500 flex-shrink-0\">\n          {t('winklink.hero.latestUpdates')}:\n        </span>\n        <div className=\"flex-1 overflow-hidden\">\n          <div className=\"flex items-center gap-6 animate-marquee whitespace-nowrap\">\n            {updates.map((update, index) => (\n              <div key={index} className=\"flex items-center gap-2 text-xs\">\n                <span\n                  className={`w-1.5 h-1.5 rounded-full ${\n                    update.type === 'price'\n                      ? 'bg-pink-500'\n                      : update.type === 'node'\n                        ? 'bg-emerald-500'\n                        : update.type === 'feed'\n                          ? 'bg-purple-500'\n                          : 'bg-gray-500'\n                  }`}\n                />\n                <span className=\"text-gray-700\">{update.text}</span>\n                <span className=\"text-gray-400\">{update.time}</span>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nexport default function WinklinkHero({\n  config,\n  price,\n  historicalData,\n  networkStats,\n  isLoading,\n  isError,\n  isRefreshing,\n  lastUpdated,\n  onRefresh,\n  onExport,\n  dataStates,\n  failedDataSources = [],\n  loadingDataSources = [],\n}: WinklinkHeroProps) {\n  const t = useTranslations();\n\n  const themeColor = config.themeColor || '#ec4899';\n\n  const currentPrice = price?.price ?? config.marketData.change24hValue ?? 0;\n  const priceChange24h = config.marketData.change24h ?? 0;\n  const isPositive = priceChange24h >= 0;\n\n  const sourceLabels: Record<string, string> = {\n    price: t('winklink.hero.sourcePrice'),\n    historical: t('winklink.hero.sourceHistorical'),\n    tron: 'TRON',\n    staking: t('winklink.hero.sourceStaking'),\n    gaming: t('winklink.hero.sourceGaming'),\n    network: t('winklink.hero.sourceNetwork'),\n    risk: t('winklink.hero.sourceRisk'),\n  };\n\n  const formatLastUpdated = (date: Date | null) => {\n    if (!date) return t('winklink.hero.unknown');\n    const now = new Date();\n    const diffMs = now.getTime() - date.getTime();\n    const diffMins = Math.floor(diffMs / 60000);\n    if (diffMins < 1) return t('winklink.hero.justNow');\n    if (diffMins < 60) return t('winklink.hero.minutesAgo', { count: diffMins });\n    const diffHours = Math.floor(diffMins / 60);\n    return t('winklink.hero.hoursAgo', { count: diffHours });\n  };\n\n  const DataStatusIndicator = () => {\n    if (!dataStates) return null;\n\n    const allSources = Object.keys(dataStates);\n\n    return (\n      <div className=\"flex items-center gap-2 flex-wrap\">\n        {allSources.map((source) => {\n          const state = dataStates[source];\n          const isFailed = failedDataSources.includes(source);\n          const isLoadingNow = loadingDataSources.includes(source);\n\n          return (\n            <div\n              key={source}\n              className={`flex items-center gap-1 px-2 py-0.5 rounded text-[10px] ${\n                isFailed\n                  ? 'bg-red-50 text-red-600'\n                  : isLoadingNow\n                    ? 'bg-blue-50 text-blue-600'\n                    : 'bg-gray-50 text-gray-500'\n              }`}\n            >\n              {isFailed ? (\n                <span className=\"w-1.5 h-1.5 rounded-full bg-red-500\" />\n              ) : isLoadingNow ? (\n                <span className=\"w-1.5 h-1.5 rounded-full bg-blue-500 animate-pulse\" />\n              ) : (\n                <span className=\"w-1.5 h-1.5 rounded-full bg-green-500\" />\n              )}\n              <span>{sourceLabels[source] || source}</span>\n              {state.lastUpdated && !isFailed && (\n                <span className=\"text-[8px] opacity-60\">\n                  ({formatLastUpdated(state.lastUpdated)})\n                </span>\n              )}\n            </div>\n          );\n        })}\n      </div>\n    );\n  };\n\n  // 生成价格走势数据\n  const priceSparkline = useMemo(() => {\n    if (historicalData.length > 0) {\n      return historicalData.slice(-24).map((d) => d.price);\n    }\n    // 模拟数据 - 使用固定种子生成确定性数据\n    return Array.from({ length: 24 }, (_, i) => {\n      const seed = (i * 9301 + 49297) % 233280;\n      const random = seed / 233280;\n      return currentPrice * (1 + (random - 0.5) * 0.1);\n    });\n  }, [historicalData, currentPrice]);\n\n  // 核心统计指标 (Primary stats) - 增加到5个\n  const primaryStats: StatItem[] = [\n    {\n      title: t('winklink.hero.winklinkPrice'),\n      value: `$${currentPrice.toFixed(6)}`,\n      change: `${isPositive ? '+' : ''}${priceChange24h.toFixed(2)}%`,\n      changeType: isPositive ? 'positive' : 'negative',\n      icon: <Activity className=\"w-4 h-4\" />,\n      subtitle: t('winklink.hero.change24h'),\n      sparklineData: priceSparkline,\n    },\n    {\n      title: t('winklink.hero.marketCap'),\n      value: `$${(config.marketData.marketCap / 1e6).toFixed(1)}M`,\n      change: '+8.3%',\n      changeType: 'positive',\n      icon: <Shield className=\"w-4 h-4\" />,\n      subtitle: t('winklink.hero.growth30d'),\n    },\n    {\n      title: t('winklink.hero.gamingDataFeeds'),\n      value: '20+',\n      change: '+15%',\n      changeType: 'positive',\n      icon: <Gamepad2 className=\"w-4 h-4\" />,\n      subtitle: t('winklink.hero.addedThisWeek'),\n    },\n    {\n      title: t('winklink.hero.supportedChains'),\n      value: `${config.supportedChains.length}+`,\n      change: '0%',\n      changeType: 'neutral',\n      icon: <Database className=\"w-4 h-4\" />,\n    },\n    {\n      title: t('winklink.hero.stakingAmount'),\n      value: `${(config.marketData.circulatingSupply / 1e6).toFixed(0)}M`,\n      change: '+5.7%',\n      changeType: 'positive',\n      icon: <Wallet className=\"w-4 h-4\" />,\n      subtitle: t('winklink.hero.totalStaked'),\n    },\n  ];\n\n  // 次要统计指标 (Secondary stats) - 4个指标\n  const secondaryStats: StatItem[] = [\n    {\n      title: t('winklink.hero.avgResponseTime'),\n      value: `${config.networkData.avgResponseTime}ms`,\n      change: '-8%',\n      changeType: 'positive',\n      icon: <Clock className=\"w-4 h-4\" />,\n    },\n    {\n      title: t('winklink.hero.networkUptime'),\n      value: `${config.networkData.nodeUptime}%`,\n      change: '+0.02%',\n      changeType: 'positive',\n      icon: <Cpu className=\"w-4 h-4\" />,\n    },\n    {\n      title: t('winklink.hero.dataFeeds'),\n      value: `${config.networkData.dataFeeds}+`,\n      change: '+12%',\n      changeType: 'positive',\n      icon: <Globe className=\"w-4 h-4\" />,\n    },\n    {\n      title: t('winklink.hero.nodeCount'),\n      value: '50+',\n      change: '+5%',\n      changeType: 'positive',\n      icon: <Server className=\"w-4 h-4\" />,\n    },\n  ];\n\n  // 网络健康度评分（模拟计算）\n  const healthScore = useMemo(() => {\n    const uptimeScore = config.networkData.nodeUptime * 0.4;\n    const responseScore = Math.max(0, 100 - config.networkData.avgResponseTime / 5) * 0.3;\n    const feedScore = Math.min(100, config.networkData.dataFeeds / 2) * 0.3;\n    return Math.round(uptimeScore + responseScore + feedScore);\n  }, [config]);\n\n  return (\n    <div className=\"bg-white border-b border-gray-200\">\n      {/* 顶部状态栏 */}\n      <div className=\"max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-2\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2\">\n          <LiveStatusBar\n            isConnected={!isError}\n            latency={networkStats?.avgResponseTime || config.networkData.avgResponseTime}\n            lastUpdate={lastUpdated || undefined}\n          />\n          <QuickActions themeColor={themeColor} />\n        </div>\n        {dataStates && <DataStatusIndicator />}\n      </div>\n\n      {/* 主要内容区 - 桌面端左右分栏布局 */}\n      <div className=\"max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-4\">\n        {/* 头部信息 - Logo、标题 */}\n        <div className=\"flex items-center gap-3 mb-4\">\n          <div\n            className=\"w-12 h-12 rounded-xl flex items-center justify-center shadow-lg flex-shrink-0\"\n            style={{ background: `linear-gradient(135deg, ${themeColor}, ${themeColor}dd)` }}\n          >\n            <OptimizedImage\n              src=\"/logos/oracles/winklink.svg\"\n              alt=\"WINkLink\"\n              width={28}\n              height={28}\n              priority\n              className=\"w-7 h-7\"\n            />\n          </div>\n          <div>\n            <h1 className=\"text-xl font-bold text-gray-900\">WINkLink</h1>\n            <p className=\"text-xs text-gray-500\">{t('winklink.subtitle')}</p>\n          </div>\n        </div>\n\n        {/* 桌面端左右分栏布局 */}\n        <div className=\"flex flex-col lg:flex-row gap-4 lg:gap-6\">\n          {/* 左侧区域（70%）- 核心指标 */}\n          <div className=\"flex-1 lg:w-[70%] lg:flex-none\">\n            <EnhancedCoreStats stats={primaryStats} themeColor={themeColor} />\n\n            {/* 次要指标行 */}\n            <CompactMetricsRow stats={secondaryStats} />\n\n            {/* 整合信息区 */}\n            <UnifiedInfoSection\n              networkStats={networkStats}\n              healthScore={healthScore}\n              chains={config.supportedChains}\n              themeColor={themeColor}\n            />\n          </div>\n\n          {/* 分隔线（仅桌面端显示） */}\n          <div className=\"hidden lg:block w-px bg-gray-200 self-stretch\" />\n\n          {/* 右侧区域（30%）- 迷你图表 + 操作按钮 */}\n          <div className=\"lg:w-[30%] flex flex-col gap-3\">\n            {/* 操作按钮 */}\n            <ActionButtons\n              onRefresh={onRefresh}\n              onExport={onExport}\n              isRefreshing={isRefreshing}\n              themeColor={themeColor}\n            />\n\n            {/* 迷你价格图表 */}\n            <div className=\"p-3 rounded-xl bg-gray-50/50 border border-gray-100 flex-1\">\n              <MiniPriceChart\n                historicalData={historicalData}\n                currentPrice={price}\n                themeColor={themeColor}\n              />\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 最新动态滚动条 */}\n      <LatestUpdates themeColor={themeColor} />\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/winklink/components/WinklinkMarketView.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'WinklinkMarketView' has too many lines (553). Maximum allowed is 50.","line":45,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":597,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'WinklinkMarketView' has a complexity of 13. Maximum allowed is 10.","line":45,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":45,"endColumn":35},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'historicalData' is defined but never used. Allowed unused args must match /^_/u.","line":48,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":48,"endColumn":17},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'isLoading' is defined but never used. Allowed unused args must match /^_/u.","line":50,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":50,"endColumn":12},{"ruleId":"max-lines","severity":2,"message