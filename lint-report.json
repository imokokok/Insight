xt-xs text-danger-600 font-medium mb-1\">\n                {t('chainlink.staking.downtime')}\n              </div>\n              <div className=\"text-sm text-gray-700\">{t('chainlink.staking.downtimeDesc')}</div>\n            </div>\n            <div className=\"p-3 bg-danger-50 rounded-lg\">\n              <div className=\"text-xs text-danger-600 font-medium mb-1\">\n                {t('chainlink.staking.incorrectData')}\n              </div>\n              <div className=\"text-sm text-gray-700\">\n                {t('chainlink.staking.incorrectDataDesc')}\n              </div>\n            </div>\n            <div className=\"p-3 bg-danger-50 rounded-lg\">\n              <div className=\"text-xs text-danger-600 font-medium mb-1\">\n                {t('chainlink.staking.malicious')}\n              </div>\n              <div className=\"text-sm text-gray-700\">{t('chainlink.staking.maliciousDesc')}</div>\n            </div>\n          </div>\n        </div>\n      </DashboardCard>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/panels/ChainlinkRiskPanel.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'RiskScoreCard' is defined but never used. Allowed unused vars must match /^_/u.","line":16,"column":25,"nodeType":"Identifier","messageId":"unusedVar","endLine":16,"endColumn":38,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"RiskScoreCard"},"fix":{"range":[320,335],"text":""},"desc":"Remove unused variable \"RiskScoreCard\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","s