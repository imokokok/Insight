             </div>\n            </div>\n            <div>\n              <div className=\"flex justify-between text-sm mb-2\">\n                <span className=\"text-gray-600\">\n                  {t('band.bandProtocol.network.stakingParticipation')}\n                </span>\n                <span className=\"font-medium text-gray-900\">51.5%</span>\n              </div>\n              <div className=\"w-full bg-gray-100 rounded-full h-1.5\">\n                <div className=\"bg-blue-500 h-1.5 rounded-full\" style={{ width: '51.5%' }} />\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 分隔线 */}\n      <div className=\"border-t border-gray-200\" />\n\n      {/* 网络统计摘要 - 简洁行内布局 */}\n      <div>\n        <h3 className=\"text-base font-medium text-gray-900 mb-4\">\n          {t('band.bandProtocol.network.cosmosMetrics')}\n        </h3>\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-6\">\n          {overviewStats.map((stat, index) => (\n            <div key={index}>\n              <p className=\"text-sm text-gray-500 mb-1\">{stat.label}</p>\n              {stat.isBlockHeight ? (\n                <div className=\"flex items-center gap-1.5\">\n                  <BlockExplorerLink blockHeight={stat.value} className=\"text-xl font-semibold\" />\n                </div>\n              ) : (\n                <p className=\"text-xl font-semibold text-gray-900\">{stat.value}</p>\n              )}\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/