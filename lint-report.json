-gray-700 mb-2\">\n                {t('chainlink.exportModal.timeRange')}\n              </label>\n              <div className=\"flex flex-wrap gap-2\">\n                {['1H', '24H', '7D', '30D', '90D', '1Y', 'ALL'].map((range) => (\n                  <button\n                    key={range}\n                    onClick={() => {\n                      setTimeRange(range);\n                      setShowCustomDateRange(false);\n                    }}\n                    className={`px-3 py-1.5  text-xs font-medium transition-all ${\n                      timeRange === range && !showCustomDateRange\n                        ? 'bg-primary-600 text-white '\n                        : 'bg-gray-100 text-gray-700 hover:bg-gray-200'\n                    }`}\n                  >\n                    {t(`chainlink.timeRange.${range}`)}\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div>\n              <button\n                onClick={() => setShowCustomDateRange(!showCustomDateRange)}\n                className=\"flex items-center gap-2 text-sm text-primary-600 hover:text-primary-700\"\n              >\n                <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path\n                    strokeLinejoin=\"round\"\n                    strokeWidth={2}\n                    d=\"M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z\"\n                  />\n                </svg>\n                {t('chainlink.exportModal.customDateRange')}\n              </button>\n\n              {showCustomDateRange && (\n                <div className=\"mt-3 grid grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"block text-xs text-gray-500 mb-1\">\n                      {t('chainlink.exportModal.startDate')}\n                    </label>\n                    <input\n                      type=\"date\"\n                      value={dateRange.start}\n                      onChange={(e) => setDateRange({ ...dateRange, start: e.target.value })}\n                      className=\"w-full px-3 py-2 border border-gray-300  text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-xs text-gray-500 mb-1\">\n                      {t('chainlink.exportModal.endDate')}\n                    </label>\n                    <input\n                      type=\"date\"\n                      value={dateRange.end}\n                      onChange={(e) => setDateRange({ ...dateRange, end: e.target.value })}\n                      className=\"w-full px-3 py-2 border border-gray-300  text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500\"\n                    />\n                  </div>\n                </div>\n              )}\n            </div>\n\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center gap-3\">\n                <input\n                  type=\"checkbox\"\n                  id=\"includeMetadata\"\n                  checked={includeMetadata}\n                  onChange={(e) => setIncludeMetadata(e.target.checked)}\n                  className=\"w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500\"\n                />\n                <label htmlFor=\"includeMetadata\" className=\"text-sm text-gray-700\">\n                  {t('chainlink.exportModal.includeMetadata')}\n                </label>\n              </div>\n\n              {(format === 'png' || format === 'svg') && (\n                <div className=\"flex items-center gap-3\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"showTimestamp\"\n                    checked={showTimestamp}\n                    onChange={(e) => setShowTimestamp(e.target.checked)}\n                    className=\"w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500\"\n                  />\n                  <label htmlFor=\"showTimestamp\" className=\"text-sm text-gray-700\">\n                    包含时间戳和数据来源\n                  </label>\n                </div>\n              )}\n\n              {showBatchExport && (\n                <div className=\"flex items-center gap-3\">\n                  <input\n                    type=\"checkbox\"\n                    id=\"batchExport\"\n                    checked={batchExport}\n                    onChange={(e) => setBatchExport(e.target.checked)}\n                    className=\"w-4 h-4 text-primary-600 border-gray-300 rounded focus:ring-primary-500\"\n                  />\n                  <label htmlFor=\"batchExport\" className=\"text-sm text-gray-700\">\n                    批量导出所有数据\n                  </label>\n                </div>\n              )}\n            </div>\n          </div>\n\n          <div className=\"mt-6 flex gap-3\">\n            <button\n              onClick={onClose}\n              className=\"flex-1 px-4 py-2.5 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200  transition-colors\"\n            >\n              {t('chainlink.exportModal.cancel')}\n            </button>\n            <button\n              onClick={handleExport}\n              className=\"flex-1 px-4 py-2.5 text-sm font-medium text-white bg-primary-600 hover:bg-primary-700  transition-colors flex items-center justify-center gap-2\"\n            >\n              <svg className=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path\n                  strokeLinejoin=\"round\"\n                  strokeWidth={2}\n                  d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4\"\n                />\n              </svg>\n              {t('chainlink.exportModal.export')}\n            </button>\n          </div>\n        </div>\n