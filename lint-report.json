   trendData,\n    marketStats,\n    chainBreakdown,\n    protocolDetails,\n    assetCategories,\n    comparisonData,\n    benchmarkData,\n    correlationData,\n    isLoading,\n    isLoadingEnhanced,\n    isLoadingComparison,\n    lastUpdated,\n    selectedTimeRange,\n    setSelectedTimeRange,\n    activeChart,\n    setActiveChart,\n    viewType,\n    setViewType,\n    hoveredItem,\n    setHoveredItem,\n    selectedItem,\n    setSelectedItem,\n    refreshInterval,\n    setRefreshInterval,\n    refreshStatus,\n    fetchData,\n    sortedOracleData: filter.filteredOracleData,\n    totalTVS,\n    totalChains,\n    totalProtocols,\n    wsStatus,\n    wsReconnect,\n\n    filter,\n    filteredAssets: filter.filteredAssets,\n\n    getChartTitle,\n    locale,\n  };\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/market-overview/useWebSocketHandler.ts","messages":[{"ruleId":"@typescript-eslint/consistent-type-imports","severity":1,"message":"`import()` type annotations are forbidden.","line":25,"column":16,"nodeType":"TSImportType","messageId":"noImportTypeAnnotations","endLine":25,"endColumn":63},{"ruleId":"@typescript-eslint/consistent-type-imports","severity":1,"message":"`import()` type annotations are forbidden.","line":26,"column":17,"nodeType":"TSImportType","messageId":"noImportTypeAnnotations","endLine":26,"endColumn":66},{"ruleId":"@typescript-eslint/consistent-type-imports","severity":1,"message":"`import()` type annotations are forbidden.","line":29,"column":7,"nodeType":"TSImportType","messageId":"noImportTypeAnnotations","endLine":29,"endColumn":54},{"