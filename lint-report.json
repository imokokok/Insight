ion>\n\n      <div className=\"border-t border-gray-200\" />\n\n      <section className=\"flex items-start gap-4 py-2\">\n        <Info className=\"w-5 h-5 text-blue-600 mt-0.5 flex-shrink-0\" />\n        <div>\n          <h3 className=\"text-sm font-semibold text-gray-900\">{t('redstone.risk.disclaimer')}</h3>\n          <p className=\"text-sm text-gray-500 mt-1 leading-relaxed\">\n            {t('redstone.risk.disclaimerText')}\n          </p>\n        </div>\n      </section>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/redstone/components/RedStoneSidebar.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Arrow function has too many lines (62). Maximum allowed is 50.","line":21,"column":21,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":82,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport {\n  BarChart3,\n  Layers,\n  Globe,\n  Zap,\n  Users,\n  ArrowLeftRight,\n  Network,\n  ShieldAlert,\n  Shield,\n  Coins,\n  Database,\n} from 'lucide-react';\n\nimport { UnifiedSidebar } from '@/components/oracle';\n\nimport { type RedStoneSidebarProps, type RedStoneTabId } from '../types';\n\nconst getNavItems = () => [\n  {\n    id: 'market' as RedStoneTabId,\n    labelKey: 'tabs.market',\n    icon: <BarChart3 className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'pull-model' as RedStoneTabId,\n    labelKey: 'tabs.pullModel',\n    icon: <Layers className=\"w-5 h-5\" str