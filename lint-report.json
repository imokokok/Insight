smDescription')}\n              </p>\n            </div>\n          </div>\n        </div>\n\n        <button className=\"w-full py-3 px-4 bg-gray-100 border border-gray-200 text-white font-medium  hover:from-green-700 hover:to-emerald-700 transition-all duration-200  hover:\">\n          {t('coveragePool.participateButton')}\n        </button>\n        <p className=\"text-xs text-gray-400 text-center\">{t('coveragePool.participateDesc')}</p>\n      </div>\n    </DashboardCard>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/panels/CrossChainPanel.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'ChainDetailModal' has too many lines (110). Maximum allowed is 50.","line":145,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":254,"endColumn":2},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'CrossChainPanel' has too many lines (410). Maximum allowed is 50.","line":256,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":665,"endColumn":2},{"ruleId":"complexity","severity":2,"message":"Function 'CrossChainPanel' has a complexity of 24. Maximum allowed is 10.","line":256,"column":8,"nodeType":"FunctionDeclaration","messageId":"complex","endLine":256,"endColumn":32},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useCallback has a missing dependency: 't'. Either include it or remove the dependency array.","line":303,"column":6,"nodeType":"ArrayExpression","endLine":303,"endColumn":14,"suggestions":[{"desc":"Update the depe