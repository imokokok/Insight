  strokeLinecap=\"round\"\n                strokeLinejoin=\"round\"\n                strokeWidth={1.5}\n                d=\"M13 10V3L4 14h7v7l9-11h-7z\"\n              />\n            </svg>\n            <span className=\"text-sm text-gray-500 whitespace-nowrap\">\n              {t('networkHealth.dataFreshness.dataLatency')}\n            </span>\n          </div>\n          <div className=\"flex items-center gap-2 flex-shrink-0\">\n            <span className={`relative flex h-2.5 w-2.5 flex-shrink-0`}>\n              <span\n                className={`animate-ping absolute inline-flex h-full w-full ${latencyStatus.bgColor} opacity-75`}\n              ></span>\n              <span className={`relative inline-flex h-2.5 w-2.5 ${latencyStatus.bgColor}`}></span>\n            </span>\n            <span className={`text-sm font-semibold ${latencyStatus.color} whitespace-nowrap`}>\n              {latency}ms\n            </span>\n            <span\n              className={`text-xs px-2 py-0.5 border border-gray-200 bg-gray-100 ${latencyStatus.color} whitespace-nowrap hidden sm:inline`}\n            >\n              {latencyStatus.label}\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/panels/DataQualityPanel.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'DataQualityPanel' has too many lines (100). Maximum allowed is 50.","line":28,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":127,"endColumn":2},{"ruleId":"