\n                  <span className=\"text-sm font-medium text-gray-900\">{service.name}</span>\n                </div>\n                <div className=\"col-span-4 text-right\">\n                  <span className=\"text-sm font-semibold text-gray-900\">{service.requests}</span>\n                </div>\n                <div className=\"col-span-3 text-right\">\n                  <div className=\"flex items-center justify-end gap-1.5\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-500\" />\n                    <span className=\"text-sm font-semibold text-emerald-600\">\n                      {service.uptime}%\n                    </span>\n                  </div>\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 服务使用分布 */}\n      <div>\n        <h3 className=\"text-sm font-semibold text-gray-900 mb-4\">\n          {t('services.usageDistribution')}\n        </h3>\n        <div className=\"h-64\">\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\n            <BarChart data={serviceUsageData}>\n              <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#f3f4f6\" />\n              <XAxis dataKey=\"name\" tick={{ fontSize: 12 }} stroke=\"#9ca3af\" />\n              <YAxis\n                tick={{ fontSize: 12 }}\n                stroke=\"#9ca3af\"\n                tickFormatter={(value) =>\n                  value >= 1000000\n                    ? `${(value / 1000000).toFixed(0)}M`\n                    : `${(value / 1000).toFixed(0)}K`\n                }\n              />\n              <Tooltip\n                contentStyle={{\n                  backgroundColor: 'white',\n                  border: '1px solid #e5e7eb',\n                  borderRadius: '6px',\n                  fontSize: '12px',\n                }}\n                formatter={(value) =>\n                  typeof value === 'number'\n                    ? value >= 1000000\n                      ? `${(value / 1000000).toFixed(2)}M`\n                      : `${(value / 1000).toFixed(0)}K`\n                    : value\n                }\n              />\n              <Bar dataKey=\"value\" radius={[4, 4, 0, 0]}>\n                {serviceUsageData.map((entry, index) => (\n                  <Cell key={`cell-${index}`} fill={entry.color} />\n                ))}\n              </Bar>\n            </BarChart>\n          </ResponsiveContainer>\n        </div>\n      </div>\n\n      {/* 服务说明 */}\n      <div>\n        <h3 className=\"text-sm font-semibold text-gray-900 mb-4\">{t('services.about')}</h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-5\">\n          <div className=\"flex items-start gap-3\">\n            <Activity className=\"w-4 h-4 text-blue-600 mt-0.5 flex-shrink-0\" />\n            <div>\n              <span className=\"text-sm font-medium text-gray-900 block mb-1\">Data Feeds</span>\n              <p className=\"text-xs text-gray-600 leading-relaxed\">{t('services.dataFeedsDesc')}</p>\n            </div>\n          </div>\n          <div className=\"flex items-start gap-3\">\n            <Zap className=\"w-4 h-4 text-purple-600 mt-0.5 flex-shrink-0\" />\n            <div>\n              <span className=\"text-sm font-medium text-gray-900 block mb-1\">VRF</span>\n              <p className=\"text-xs text-gray-600 leading-relaxed\">{t('services.vrfDesc')}</p>\n            </div>\n          </div>\n          <div className=\"flex items-start gap-3\">\n            <Clock className=\"w-4 h-4 text-emerald-600 mt-0.5 flex-shrink-0\" />\n            <div>\n              <span className=\"text-sm font-medium text-gray-900 block mb-1\">Automation</span>\n              <p className=\"text-xs text-gray-600 leading-relaxed\">\n                {t('services.automationDesc')}\n              </p>\n            </div>\n          </div>\n          <div className=\"flex items-start gap-3\">\n            <TrendingUp className=\"w-4 h-4 text-amber-600 mt-0.5 flex-shrink-0\" />\n            <div>\n              <span className=\"text-sm font-medium text-gray-900 block mb-1\">CCIP</span>\n              <p className=\"text-xs text-gray-600 leading-relaxed\">{t('services.ccipDesc')}</p>\n            </div>\n          </div>\n          <div className=\"flex items-start gap-3\">\n            <BarChart3 className=\"w-4 h-4 text-red-600 mt-0.5 flex-shrink-0\" />\n            <div>\n              <span className=\"text-sm font-medium text-gray-900 block mb-1\">Functions</span>\n              <p className=\"text-xs text-gray-600 leading-relaxed\">{t('services.functionsDesc')}</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/chainlink/components/ChainlinkSidebar.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'t' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":93,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":93,"endColumn":10}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport {\n  BarChart3,\n  Globe,\n  Server,\n  Database,\n  Layers,\n  Network,\n  ShieldAlert,\n  ArrowRightLeft,\n  Activity,\n  Zap,\n  Clock,\n  Code,\n  Shield,\n} from 'lucide-react';\n\nimport { UnifiedSidebar } from '@/components/oracle';\nimport { useTranslations } from '@/i18n';\n\nimport { type ChainlinkSidebarProps, type ChainlinkTabId } from '../types';\n\nconst navItems = [\n  {\n    id: 'market' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.marketData',\n    icon: <BarChart3 className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'network' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.networkHealth',\n    icon: <Globe className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'nodes' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.nodes',\n    icon: <Server className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'data-feeds' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.dataFeeds',\n    icon: <Database className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'data-streams' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.dataStreams',\n    icon: <Activity className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'services' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.services',\n    icon: <Layers className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'ccip' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.ccip',\n    icon: <ArrowRightLeft className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'vrf' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.vrf',\n    icon: <Zap className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'automation' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.automation',\n    icon: <Clock className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'functions' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.functions',\n    icon: <Code className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'ecosystem' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.ecosystem',\n    icon: <Network className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'risk' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.riskAssessment',\n    icon: <ShieldAlert className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n  {\n    id: 'proof-of-reserve' as ChainlinkTabId,\n    labelKey: 'chainlink.menu.proofOfReserve',\n    icon: <Shield className=\"w-5 h-5\" strokeWidth={1.5} />,\n  },\n];\n\nexport function ChainlinkSidebar({ activeTab, onTabChange }: ChainlinkSidebarProps) {\n  const t = useTranslations();\n\n  return (\n    <UnifiedSidebar\n      items={navItems}\n      activeTab={activeTab}\n      onTabChange={(tab) => onTabChange(tab as ChainlinkTabId)}\n      themeColor=\"#375bd2\"\n    />\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/chainlink/components/ChainlinkStakingView.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ArrowDownRight' is defined but never used. Allowed unused vars must match /^_/u.","line":22,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":22,"endColumn":17,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ArrowDownRight"},"fix":{"range":[275,293],"text":""},"desc":"Remove unused variable \"ArrowDownRight\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Legend' is defined but never used. Allowed unused vars must match /^_/u.","line":37,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":37,"endColumn":9,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Legend"},"fix":{"range":[476,486],"text":""},"desc":"Remove unused variable \"Legend\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'PIE_COLORS' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":150,"column":7,"nodeType":"Identifier","messageId":"unusedVar","endLine":1