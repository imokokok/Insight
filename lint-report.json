ueryId}</span>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Query Data Structure Info */}\n      <div className=\"bg-gradient-to-r from-cyan-50 to-blue-50 rounded-xl border border-cyan-100 p-6\">\n        <div className=\"flex items-start gap-3\">\n          <Info className=\"w-5 h-5 text-cyan-600 flex-shrink-0 mt-0.5\" />\n          <div>\n            <h4 className=\"text-sm font-medium text-cyan-900\">{t('queryData.whatIsQueryId')}</h4>\n            <p className=\"text-xs text-cyan-700 mt-1\">{t('queryData.queryIdDescription')}</p>\n            <div className=\"mt-3 p-3 bg-white/50 rounded-lg\">\n              <p className=\"text-xs text-cyan-800 font-mono\">Query ID = keccak256(Query Data)</p>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/tellor/components/TellorReportersView.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Globe' is defined but never used. Allowed unused vars must match /^_/u.","line":13,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":13,"endColumn":8,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Globe"},"fix":{"range":[141,150],"text":""},"desc":"Remove unused variable \"Globe\"."}]},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'TellorReportersView' has too many lines (278). Maximum allowed is 50.","line":104,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":381,"endCol