RewardAmount)}`}\n        />\n        <StatCard\n          label={t('uma.disputeResolution.avgTotalValue') || '平均总价值'}\n          value={`${formatAmount(stats.avgTotalValue)} UMA`}\n        />\n        <StatCard\n          label={t('uma.disputeResolution.totalStakeAmount') || '总质押金额'}\n          value={`${formatAmount(stats.totalStakeAmount)} UMA`}\n          subValue={`总奖励: ${formatAmount(stats.totalRewardAmount)}`}\n        />\n      </div>\n\n      {/* 金额分布直方图和效率指标 */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        <AmountDistributionHistogram amountRanges={stats.amountRanges} />\n        <EfficiencyMetricsCard efficiency={stats.efficiency} totalResolved={totalResolved} />\n      </div>\n\n      {/* 金额趋势图 */}\n      <AmountTrendChart amountTrends={stats.amountTrends} />\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/data-display/DisputeEfficiencyAnalysis.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'DisputeEfficiencyAnalysis' has too many lines (163). Maximum allowed is 50.","line":14,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":176,"endColumn":2}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { useState, useEffect } from 'react';\n\nimport { useTranslations } from '@/i18n';\nimport { chartColors } from '@/lib/config/colors';\nimport { UMAClient, type DisputeEfficiencyStats } from '@/lib/oracles/uma';\nimport { createLogger } 