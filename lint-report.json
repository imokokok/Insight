1 ? 'text-danger-600' : 'text-success-600'\n                      }`}\n                    >\n                      {item.avgDev.toFixed(4)}%\n                    </span>\n                  </div>\n                ))}\n            </div>\n          </div>\n        </div>\n\n        {stats.anomalyCount > 0 && (\n          <div className=\"bg-danger-50 border border-danger-200  p-4\">\n            <div className=\"flex items-start gap-3\">\n              <svg\n                className=\"w-5 h-5 text-danger-600 flex-shrink-0 mt-0.5\"\n                fill=\"currentColor\"\n                viewBox=\"0 0 20 20\"\n              >\n                <path\n                  fillRule=\"evenodd\"\n                  d=\"M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z\"\n                  clipRule=\"evenodd\"\n                />\n              </svg>\n              <div>\n                <h4 className=\"text-sm font-semibold text-danger-800 mb-1\">\n                  {t('priceDeviationHeatmap.highDeviationDetected')}\n                </h4>\n                <p className=\"text-xs text-danger-700\">\n                  {t('priceDeviationHeatmap.anomalyWarning', { count: stats.anomalyCount })}\n                </p>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </DashboardCard>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/charts/PriceDeviationHistoryChart.