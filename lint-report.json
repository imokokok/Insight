e;\n\n    return () => {\n      if (timeoutRef.current) {\n        clearTimeout(timeoutRef.current);\n      }\n    };\n  }, [price]);\n\n  return (\n    <div className=\"flex flex-col items-start\">\n      <div className=\"flex items-baseline gap-1\">\n        <span className=\"text-gray-400 text-3xl font-light\">$</span>\n        <span\n          className={`text-6xl md:text-7xl font-bold tracking-tight transition-all duration-300 ${\n            flashColor === 'green'\n              ? 'text-success-600 scale-105'\n              : flashColor === 'red'\n                ? 'text-danger-600 scale-105'\n                : 'text-gray-900'\n          } ${isAnimating ? 'scale-105' : 'scale-100'}`}\n        >\n          {price.toFixed(2)}\n        </span>\n      </div>\n    </div>\n  );\n}\n\nfunction PriceChangeIndicator({\n  change,\n  changeValue,\n  high24h,\n  low24h,\n}: {\n  change: number;\n  changeValue: number;\n  high24h: number;\n  low24h: number;\n}) {\n  const t = useTranslations();\n  const isPositive = change >= 0;\n\n  return (\n    <div className=\"flex flex-col gap-2\">\n      <div className=\"flex items-center gap-2\">\n        <div\n          className={`flex items-center gap-1.5 px-3 py-1.5 font-semibold text-base border ${\n            isPositive\n              ? 'bg-success-50 text-success-600 border-green-200'\n              : 'bg-danger-50 text-danger-600 border-danger-200'\n          }`}\n        >\n          <span className=\"text-lg\">{isPositive ? '↑' : '↓'}</span>\n          <span>\n            {isPositive ? '+' : ''}\n            {change.toFixed(2)}%\n          </span>\n        </div>\n        <div className=\"text-gray-500 text-sm\">\n          <span className={isPositive ? 'text-success-600' : 'text-danger-600'}>\n            {isPositive ? '+' : ''}${changeValue.toFixed(2)}\n          </span>\n          <span className=\"ml-1\">(24h)</span>\n        </div>\n      </div>\n\n      <div className=\"flex items-center gap-3 text-xs\">\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"text-gray-500\">{t('marketDataPanel.24hHigh')}</span>\n          <span className=\"text-success-600 font-medium\">${high24h.toFixed(2)}</span>\n        </div>\n        <div className=\"w-px h-3 bg-gray-300\" />\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"text-gray-500\">{t('marketDataPanel.24hLow')}</span>\n          <span className=\"text-danger-600 font-medium\">${low24h.toFixed(2)}</span>\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction EMADisplay({\n  emaData,\n  selectedPeriod,\n  onPeriodChange,\n}: {\n  emaData: EMAData[];\n  selectedPeriod: EMAPeriod;\n  onPeriodChange: (period: EMAPeriod) => void;\n}) {\n  const t = useTranslations();\n  const selectedEMA = emaData.find((ema) => ema.period === selectedPeriod);\n\n  const trendColors = {\n    up: 'text-success-600',\n    down: 'text-danger-600',\n    neutral: 'text-gray-600',\n  };\n\n  const trendIcons = {\n    up: '↑',\n    down: '↓',\n    neutral: '→',\n  };\n\n  return (\n    <div className=\"bg-purple-50 border border-purple-200 p-3\">\n      <div className=\"flex items-center justify-between mb-2\">\n        <div className=\"flex items-center gap-2\">\n          <svg\n            className=\"w-4 h-4 text-purple-600\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            viewBox=\"0 0 24 24\"\n          >\n            <path\n              strokeLinejoin=\"round\"\n              strokeWidth={1.5}\n              d=\"M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z\"\n            />\n          </svg>\n          <span className=\"text-sm font-semibold text-purple-900\">\n            {t('pythNetwork.ema.title')}\n          </span>\n        </div>\n        <div className=\"flex gap-1\">\n          {[7, 14, 30].map((period) => (\n            <button\n              key={period}\n              onClick={() => onPeriodChange(period as EM