ont-semibold text-danger-700 mb-3 flex items-center gap-2\">\n              <ArrowDown className=\"w-4 h-4\" />\n              {t('tellor.marketDepth.asks')}\n            </h4>\n            <div className=\"space-y-2\">\n              {askLevels.slice(0, 10).map((level, index) => (\n                <div key={index} className=\"flex items-center justify-between py-1\">\n                  <span className=\"text-sm font-medium text-danger-700\">\n                    ${level.price.toFixed(4)}\n                  </span>\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"w-32 bg-danger-200 rounded-full h-2\">\n                      <div\n                        className=\"bg-danger-500 h-2 rounded-full\"\n                        style={{ width: `${(level.askVolume / maxVolume) * 100}%` }}\n                      />\n                    </div>\n                    <span className=\"text-sm text-gray-600 w-20 text-right\">\n                      {level.askVolume.toLocaleString()}\n                    </span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </DashboardCard>\n  );\n}\n\nexport { TellorMarketDepthPanel as TellarMarketDepthPanel };\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/panels/TellorMultiChainAggregationPanel.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'MultiChainPrice' is defined but never used. Allowed unused vars must match /^_/u.","line":7,"column":38,"n