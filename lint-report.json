re-mode-desc\" className=\"sr-only\">\n                {t('priceQuery.selectors.compareModeDesc')}\n              </span>\n\n              <label className=\"flex items-center gap-2.5 cursor-pointer p-2 rounded-md hover:bg-white transition-colors\">\n                <input\n                  type=\"checkbox\"\n                  checked={showBaseline}\n                  onChange={(e) => setShowBaseline?.(e.target.checked)}\n                  aria-describedby=\"baseline-desc\"\n                  className=\"rounded border-gray-300 text-purple-600 focus:ring-purple-500 w-4 h-4\"\n                />\n                <span className=\"text-xs font-medium text-gray-700\">\n                  {t('priceQuery.selectors.showBaseline')}\n                </span>\n              </label>\n              <span id=\"baseline-desc\" className=\"sr-only\">\n                {t('priceQuery.selectors.baselineDesc')}\n              </span>\n\n              {isCompareMode && (\n                <div className=\"pt-2 border-t border-gray-200 mt-2\">\n                  <SegmentedControl\n                    options={timeRangeOptions}\n                    value={compareTimeRange}\n                    onChange={(value) => setCompareTimeRange?.(value as number)}\n                    label={t('priceQuery.selectors.compareTime')}\n                    aria-label={t('priceQuery.selectors.compareTimeLabel')}\n                    size=\"sm\"\n                  />\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Docume