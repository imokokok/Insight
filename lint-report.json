ext-gray-500\">{t('chronicle.validators.regions')}</span>\n                <span className=\"font-medium text-gray-900\">{regionStats.length}</span>\n              </div>\n            </div>\n          </section>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/chronicle/components/ChronicleVaultView.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Activity' is defined but never used. Allowed unused vars must match /^_/u.","line":12,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":11,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Activity"},"fix":{"range":[130,142],"text":""},"desc":"Remove unused variable \"Activity\"."}]},{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'ChronicleVaultView' has too many lines (552). Maximum allowed is 50.","line":193,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":744,"endColumn":2},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'isLoading' is defined but never used. Allowed unused args must match /^_/u.","line":193,"column":49,"nodeType":"Identifier","messageId":"unusedVar","endLine":193,"endColumn":58},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (705). Maximum allowed is 500.","line":530,"column":1,"nodeType":null,"messageId":"exceed","endLine":745,"endColumn":1},{"ruleId":"max-lines-per-function","severity":2,"message":"Arrow function has too many lines (64). Maximum allowed is 50.","line