: string;\n  status: 'active' | 'inactive';\n  tvl: number;\n  volume24h: number;\n}\n\nexport function CosmosEcosystemPanel({ client }: CosmosEcosystemPanelProps) {\n  const t = useTranslations();\n  const [ibcChains, setIbcChains] = useState<IBCChain[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    const mockIBCChains: IBCChain[] = [\n      {\n        name: 'Cosmos Hub',\n        chainId: 'cosmoshub-4',\n        channelId: 'channel-0',\n        status: 'active',\n        tvl: 2500000000,\n        volume24h: 150000000,\n      },\n      {\n        name: 'Osmosis',\n        chainId: 'osmosis-1',\n        channelId: 'channel-1',\n        status: 'active',\n        tvl: 1800000000,\n        volume24h: 280000000,\n      },\n      {\n        name: 'Juno',\n        chainId: 'juno-1',\n        channelId: 'channel-2',\n        status: 'active',\n        tvl: 120000000,\n        volume24h: 8500000,\n      },\n      {\n        name: 'Stargaze',\n        chainId: 'stargaze-1',\n        channelId: 'channel-3',\n        status: 'active',\n        tvl: 85000000,\n        volume24h: 5200000,\n      },\n      {\n        name: 'Akash',\n        chainId: 'akashnet-2',\n        channelId: 'channel-4',\n        status: 'active',\n        tvl: 65000000,\n        volume24h: 3200000,\n      },\n      {\n        name: 'Persistence',\n        chainId: 'core-1',\n        channelId: 'channel-5',\n        status: 'active',\n        tvl: 45000000,\n        volume24h: 2100000,\n      },\n    ];\n\n    setIbcChains(mockIBCChains);\n    setLoading(false);\n  }, [client]);\n\n  if (loading) {\n    return (\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {[...Array(4)].map((_, i) => (\n          <div key={i} className=\"h-24 bg-gray-100 animate-pulse\" />\n        ))}\n      </div>\n    );\n  }\n\n  const formatCurrency = (value: number) => {\n    if (value >= 1e9) {\n      return `$${(value / 1e9).toFixed(2)}B`;\n    }\n    if (value >= 1e6) {\n      return `$${(value / 1e6).toFixed(2)}M`;\n    }\n    return `$${value.toLocaleString()}`;\n  };\n\n  const totalTVL = ibcChains.reduce((sum, chain) => sum + chain.tvl, 0);\n  const totalVolume24h = ibcChains.reduce((sum, chain) => sum + chain.volume24h, 0);\n  const activeChains = ibcChains.filter((c) => c.status === 'active').length;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Cosmos Ecosystem Stats */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <MetricCard\n          label={t('band.bandProtocol.ecosystem.cosmosSdkVersion')}\n          value=\"v0.47\"\n          subValue={t('band.bandProtocol.ecosystem.cosmosSdk')}\n          icon={<Layers className=\"w-4 h-4\" />}\n        />\n        <MetricCard\n          label={t('band.bandProtocol.ecosystem.ibcConnections')}\n          value={activeChains.toString()}\n          subValue={t('band.bandProtocol.ecosystem.activeIBCChannels')}\n          icon={<Link2 className=\"w-4 h-4\" />}\n        />\n        <MetricCard\n          label={t('band.bandProtocol.ecosystem.totalIBCTVL')}\n          value={formatCurrency(totalTVL)}\n          subValue={`↑ 8.5% ${t('band.bandProtocol.ecosystem.totalValueLocked')}`}\n          icon={<Wallet className=\"w-4 h-4\" />}\n        />\n        <MetricCard\n          label={t('band.bandProtocol.ecosystem.ibcVolume24h')}\n          value={formatCurrency(totalVolume24h)}\n          subValue={`↑ 12.3% ${t('band.bandProtocol.ecosystem.volumeChange')}`}\n          icon={<BarChart3 className=\"w-4 h-4\" />}\n        />\n      </div>\n\n      {/* IBC Connections */}\n      <Card>\n        <CardHeader>\n          <CardTitle className=\"text-lg font-semibold\">\n            {t('band.bandProtocol.ecosystem.ibcConnections')}\n          </CardTitle>\n        </CardHeader>\n        <CardContent>\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full\">\n              <thead>\n                <tr className=\"border-b border-gray-200\">\n                  <th className=\"text-left py-3 px-4 text-sm font-medium text-gray-500\">\n                    {t('band.bandProtocol.ecosystem.chainName')}\n                  </th>\n                  <th className=\"text-left py-3 px-4 text-sm font-medium text-gray-500\">\n                    {t('band.bandProtocol.ecosystem.chainId')}\n                  </th>\n                  <th className=\"text-left py-3 px-4 text-sm font-medium text-gray-500\">\n                    {t('band.bandProtocol.ecosystem.channelId')}\n                  </th>\n                  <th className=\"text-right py-3 px-4 text-sm font-medium text-gray-500\">\n                    {t('band.bandProtocol.ecosystem.tvl')}\n                  </th>\n                  <th className=\"text-right py-3 px-4 text-sm font-medium text-gray-500\">\n                    {t('band.bandProtocol.ecosystem.volume24h')}\n                  </th>\n                  <th className=\"text-center py-3 px-4 text-sm font-medium text-gray-500\">\n                    {t('band.bandProtocol.ecosystem.status')}\n                  </th>\n                </tr>\n              </thead>\n              <tbody>\n                {ibcChains.map((chain, index) => (\n                  <tr\n                    key={chain.chainId}\n                    className={`border-b border-gray-100 ${index % 2 === 0 ? 'bg-gray-50/50' : ''}`}\n                  >\n                    <td className=\"py-3 px-4\">\n                      <span className=\"font-medium text-gray-900\">{chain.name}</span>\n                    </td>\n                    <td className=\"py-3 px-4 text-sm text-gray-600\">{chain.chainId}</td>\n                    <td className=\"py-3 px-4 text-sm text-gray-600\">{chain.channelId}</td>\n                    <td className=\"text-right py-3 px-4 text-sm text-gray-600\">\n                      {formatCurrency(chain.tvl)}\n                    </td>\n                    <td className=\"