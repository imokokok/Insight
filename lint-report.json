       {loading ? (\n              <div className=\"py-16 flex flex-col justify-center items-center gap-3 bg-white rounded-lg border border-gray-200 mt-4\">\n                <div className=\"w-8 h-8 border-2 border-gray-400 border-t-transparent animate-spin rounded-full\" />\n                <div className=\"text-sm text-gray-500\">{t('crossChain.loadingData')}</div>\n              </div>\n            ) : (\n              <div className=\"mt-4\">\n                {activeTab === 'overview' && renderOverviewTab()}\n                {activeTab === 'correlation' && renderCorrelationTab()}\n                {activeTab === 'advanced' && renderAdvancedTab()}\n                {activeTab === 'charts' && renderChartsTab()}\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/cross-chain/useCrossChainData.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'safeBlockchainCast' is defined but never used. Allowed unused vars must match /^_/u.","line":23,"column":24,"nodeType":"Identifier","messageId":"unusedVar","endLine":23,"endColumn":42,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"safeBlockchainCast"},"fix":{"range":[509,529],"text":""},"desc":"Remove unused variable \"safeBlockchainCast\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'calculatePearsonCorrelation' is defined but never used. Allowed unused vars must match /^_/u.","line":42,"column":3,"nodeType":"Identifier","messageId":"unu