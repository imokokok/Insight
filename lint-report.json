t?: (key: string) => void;\n  isLoading?: boolean;\n}\n\nexport function ChainlinkDataTable<T>({\n  data,\n  columns,\n  sortConfig: externalSortConfig,\n  onSort: externalOnSort,\n  isLoading,\n}: ChainlinkDataTableProps<T>) {\n  const t = useTranslations('chainlink');\n  const [internalSortConfig, setInternalSortConfig] = useState<SortConfig | undefined>();\n\n  const sortConfig = externalSortConfig ?? internalSortConfig;\n\n  const handleSort = (key: string) => {\n    if (externalOnSort) {\n      externalOnSort(key);\n    } else {\n      setInternalSortConfig((current) => {\n        if (!current || current.key !== key) {\n          return { key, direction: 'asc' };\n        }\n        return { key, direction: current.direction === 'asc' ? 'desc' : 'asc' };\n      });\n    }\n  };\n\n  const sortedData = [...data].sort((a, b) => {\n    if (!sortConfig) return 0;\n    const column = columns.find((col) => col.key === sortConfig.key);\n    if (!column) return 0;\n    const aValue = a[column.key];\n    const bValue = b[column.key];\n    if (aValue === bValue) return 0;\n    if (aValue === null || aValue === undefined) return 1;\n    if (bValue === null || bValue === undefined) return -1;\n    const comparison = aValue < bValue ? -1 : 1;\n    return sortConfig.direction === 'asc' ? comparison : -comparison;\n  });\n\n  if (isLoading) {\n    return (\n      <div className=\"animate-pulse\">\n        <div className=\"h-10 bg-gray-50 border-b border-gray-200\" />\n        {[...Array(5)].map((_, i) => (\n          <div key={i} className=\"h-12 border-b border-gray-100\" />\n        ))}\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"overflow-x-auto\">\n      <table className=\"w-full\">\n        <thead>\n          <tr className=\"border-b border-gray-200\">\n            {columns.map((column) => {\n              const isSorted = sortConfig?.key === column.key;\n              const sortDirection = isSorted ? sortConfig.direction : null;\n              const sortDescriptionId = `sort-desc-${String(column.key)}`;\n\n              return (\n                <th\n                  key={String(column.key)}\n                  className={`\n                    px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\n                    ${column.sortable ? 'cursor-pointer hover:text-gray-700' : ''}\n                    ${column.width ? column.width : ''}\n                  `}\n                  onClick={() => column.sortable && handleSort(String(column.key))}\n                  {...(column.sortable && {\n                    'aria-label': `${column.header}, ${isSorted ? (sortDirection === 'asc' ? t('dataTable.sort.asc') : t('dataTable.sort.desc')) : t('dataTable.sort.unsorted')}`,\n                    'aria-pressed': isSorted,\n                    'aria-describedby': isSorted ? sortDescriptionId : undefined,\n                    role: 'button',\n                    tabIndex: 0,\n                    onKeyDown: (e) => {\n                      if (e.key === 'Enter' || e.key === ' ') {\n                        e.preventDefault();\n                        handleSort(String(column.key));\n                      }\n                    },\n                  })}\n                >\n                  <div className=\"flex items-center gap-1\">\n                    {column.header}\n                    {column.sortable && sortConfig?.key === column.key && (\n                      <>\n                        <span className=\"text-gray-400\" aria-hidden=\"true\">\n                          {sortConfig.direction === 'asc' ? '↑' : '↓'}\n                        </span>\n                        <span id={sortDescriptionId} className=\"sr-only\">\n                          {sortDirection === 'asc'\n                            ? t('dataTable.sort.asc')\n                            : t('dataTable.sort.desc')}\n                        </span>\n                      </>\n                    )}\n                  </div>\n                </th>\n              );\n            })}\n          </tr>\n        </thead>\n        <tbody>\n          {sortedData.map((item, index) => (\n            <tr\n              key={index}\n              className=\"border-b border-gray-100 hover:bg-gray-50/50 transition-colors\"\n            >\n              {columns.map((column) => (\n                <td key={String(column.key)} className=\"px-4 py-3 text-sm text-gray-900\">\n                  {column.render ? column.render(item) : String(item[column.key] ?? '-')}\n                </td>\n              ))}\n            </tr>\n          ))}\n        </tbody>\n      </table>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/chainlink/components/ChainlinkEcosystemView.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'ChainlinkEcosystemView' has too many lines (374). Maximum allowed is 50.","line":190,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":563,"endColumn":2},{"ruleId":"max-lines","severity":2,"message":"File has too many lines (538). Maximum allowed is 500.","line":527,"column":1,"nodeType":null,"messageId":"exceed","endLine":566,"endColumn":1}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport { useState, useMemo, useCallback, memo } from 'react';\n\nimport { TrendingUp, Layers, Globe, Zap } from 'lucide-react';\nimport {\n  AreaChart,\n  Area,\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  CartesianGrid,\n  Tooltip as R