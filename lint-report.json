=\"sm:hidden\">\n        <div\n          className=\"flex gap-1 p-1 rounded-lg overflow-x-auto scrollbar-hide\"\n          style={{ backgroundColor: baseColors.gray[100] }}\n        >\n          {tabs.map((tab) => {\n            const isActive = activeTab === tab.id;\n            return (\n              <button\n                key={tab.id}\n                onClick={() => onTabChange(tab.id)}\n                className={`relative px-3 py-1.5 text-xs font-medium rounded-md transition-all duration-200 whitespace-nowrap flex-shrink-0 ${\n                  isActive ? 'shadow-sm' : 'hover:text-gray-900'\n                }`}\n                style={{\n                  backgroundColor: isActive ? baseColors.primary[600] : 'transparent',\n                  color: isActive ? '#ffffff' : baseColors.gray[600],\n                }}\n              >\n                {tab.label}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/cross-chain/components/VolatilitySurface.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'VolatilitySurface' has too many lines (626). Maximum allowed is 50.","line":58,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":683,"endColumn":2},{"ruleId":"max-lines-per-function","severity":2,"message":"Arrow function has too many lines (61). Maximum allowed is 50.","line":184,"column":29,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":244,"endColumn":4},{"ruleId":"max-line