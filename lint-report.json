  border border-gray-200 p-6\">\n      <div className=\"flex items-center justify-between mb-6\">\n        <h3 className=\"text-lg font-semibold text-gray-900\">{t('pyth.extreme.title')}</h3>\n        <div className=\"flex items-center gap-2\">\n          <span className=\"px-3 py-1 bg-danger-100 text-danger-700 text-sm font-medium \">\n            {stats.totalEvents} {t('pyth.extreme.events')}\n          </span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4 mb-6\">\n        <div className=\"p-4 bg-gray-50 \">\n          <p className=\"text-sm text-gray-600 mb-1\">{t('pyth.extreme.totalEvents')}</p>\n          <p className=\"text-2xl font-bold text-gray-900\">{stats.totalEvents}</p>\n        </div>\n        <div className=\"p-4 bg-gray-50 \">\n          <p className=\"text-sm text-gray-600 mb-1\">{t('pyth.extreme.avgRecovery')}</p>\n          <p className=\"text-2xl font-bold text-primary-600\">{stats.avgRecoveryTime}s</p>\n        </div>\n        <div className=\"p-4 bg-gray-50 \">\n          <p className=\"text-sm text-gray-600 mb-1\">{t('pyth.extreme.avgDeviation')}</p>\n          <p className=\"text-2xl font-bold text-warning-600\">{stats.avgDeviation}%</p>\n        </div>\n        <div className=\"p-4 bg-gray-50 \">\n          <p className=\"text-sm text-gray-600 mb-1\">{t('pyth.extreme.highSeverity')}</p>\n          <p className=\"text-2xl font-bold text-danger-600\">{stats.highSeverityCount}</p>\n        </div>\n      </div>\n\n      <div className=\"mb-6\">\n        <h4 className=\"text-sm font-medium text-gray-700 mb-3\">{t('pyth.extreme.eventTypes')}</h4>\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3\">\n          {Object.entries(EVENT_TYPE_CONFIG).map(([type, config]) => (\n            <div key={type} className={`p-3  border ${config.bgColor} ${config.borderColor}`}>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <span style={{ color: config.color }}>{config.icon}</span>\n                <span className=\"text-sm font-medium text-gray-700\">\n                  {t(`pyth.extreme.type_${type}`)}\n                </span>\n              </div>\n              <p className=\"text-2xl font-bold\" style={{ color: config.color }}>\n                {eventTypeCounts[type] || 0}\n              </p>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      <div>\n        <h4 className=\"text-sm font-medium text-gray-700 mb-3\">{t('pyth.extreme.timeline')}</h4>\n        {events.length === 0 ? (\n          <div className=\"text-center py-8 text-gray-500\">{t('pyth.extreme.noEvents')}</div>\n        ) : (\n          <div className=\"relative\">\n            <div className=\"absolute left-4 top-0 bottom-0 w-0.5 bg-gray-200\" />\n            <div className=\"space-y-4\">\n              {events.map((event, index) => {\n                const typeConfig = EVENT_TYPE_CONFIG[event.type];\n                const severityConfig = SEVERITY_CONFIG[event.severity];\n\n                return (\n                  <div key={event.id} className=\"relative pl-10\">\n                    <div\n                      className=\"absolute left-2.5 w-3 h-3  border-2 border-white\"\n                      style={{ backgroundColor: typeConfig.color, top: '1.25rem' }}\n                    />\n\n                    <div className={`p-4  border ${typeConfig.bgColor} ${typeConfig.borderColor}`}>\n                      <div className=\"flex items-start justify-between mb-2\">\n                        <div className=\"flex items-center gap-2\">\n                          <span style={{ color: typeConfig.color }}>{typeConfig.icon}</span>\n                          <span className=\"font-medium text-gray-900\">\n                            {t(`pyth.extreme.type_${event.type}`)}\n                          </span>\n                          <span\n                            className=\"px-2 py-0.5 text-xs font-medium \"\n                            style={{\n                              backgroundColor: `${severityConfig.color}20`,\n                              color: severityConfig.color,\n                            }}\n                          >\n                            {severityConfig.label}\n                          </span>\n                        </div>\n                        <span className=\"text-sm text-gray-500\">{event.date}</span>\n                      </div>\n\n                      <p className=\"text-sm text-gray-600 mb-3\">{event.description}</p>\n\n                      <div className=\"grid grid-cols-3 gap-4 text-sm\">\n                        <div>\n                          <span className=\"text-gray-500\">{t('pyth.extreme.oraclePrice')}:</span>\n                          <span className=\"ml-2 font-mono font-medium\">\n                            ${event.oraclePrice.toFixed(4)}\n                          </span>\n                        </div>\n                        <div>\n                          <span className=\"text-gray-500\">{t('pyth.extreme.marketPrice')}:</span>\n                          <span className=\"ml-2 font-mono font-medium\">\n                            ${event.marketPrice.toFixed(4)}\n                          </span>\n                        </div>\n                        <div>\n                          <span className=\"text-gray-500\">{t('pyth.extreme.recovery')}:</span>\n                          <span className=\"ml-2 font-medium text-primary-600\">\n                            {event.recoveryTime}s\n                          </span>\n                        </div>\n                      </div>\n\n                      <div className=\"mt-3 pt-3 border-t border-gray-200\">\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"text-sm text-gray-500\">\n                            {t('pyth.extreme.deviation')}\n                          </span>\n                          <div className=\"flex items-center gap-2\">\n                            <div className=\"w-32 h-2 bg-gray-200  overflow-hidden\">\n                              <div\n                                className=\"h-full \"\n                                style={{\n                                  width: `${Math.min(Math.abs(event.deviation) * 20, 100)}%`,\n                                  backgroundColor: typeConfig.color,\n                                }}\n                              />\n                            </div>\n                            <span className=\"text-sm font-bold\" style={{ color: typeConfig.color }}>\n                              {event.deviation.toFixed(3)}%\n                            </span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/data-display/IntegratedProtocols.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-esl