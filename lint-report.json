  <div className=\"pt-6 border-t border-gray-200\">\n        <h3 className=\"text-sm font-medium text-gray-500 uppercase tracking-wider mb-4\">\n          {t('dia.dataFeeds.about')}\n        </h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-sm text-gray-600\">\n          <div>\n            <p className=\"mb-2\">\n              <span className=\"font-medium text-gray-900\">{t('dia.dataFeeds.confidence')}:</span>{' '}\n              {t('dia.dataFeeds.confidenceDesc')}\n            </p>\n            <p>\n              <span className=\"font-medium text-gray-900\">{t('dia.dataFeeds.multiChain')}:</span>{' '}\n              {t('dia.dataFeeds.multiChainDesc')}\n            </p>\n          </div>\n          <div>\n            <p className=\"mb-2\">\n              <span className=\"font-medium text-gray-900\">{t('dia.dataFeeds.transparency')}:</span>{' '}\n              {t('dia.dataFeeds.transparencyDesc')}\n            </p>\n            <p>\n              <span className=\"font-medium text-gray-900\">{t('dia.dataFeeds.customFeeds')}:</span>{' '}\n              {t('dia.dataFeeds.customFeedsDesc')}\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/dia/components/DIAEcosystemView.tsx","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'PartnerCard' has too many lines (115). Maximum allowed is 50.","line":99,"column":1,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":213,"endColumn":2},{"ruleId":"max-lines-pe