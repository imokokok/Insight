   >\n        <div className=\"sticky top-0 bg-white border-b border-gray-200 px-6 py-4 z-10\">\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-10 h-10 bg-violet-100 rounded-lg flex items-center justify-center\">\n                <Shield className=\"w-5 h-5 text-violet-600\" />\n              </div>\n              <div>\n                <h2 className=\"text-lg font-semibold text-gray-900\">{publisher.name}</h2>\n                <p className=\"text-sm text-gray-500\">\n                  {t('pyth.publisher.id')}: {publisher.id}\n                </p>\n              </div>\n            </div>\n            <button\n              onClick={onClose}\n              className=\"p-2 hover:bg-gray-100 rounded-md transition-colors\"\n            >\n              <X className=\"w-5 h-5 text-gray-500\" />\n            </button>\n          </div>\n        </div>\n\n        <div className=\"p-6 space-y-8\">\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n            <div className=\"bg-gray-50 p-4 rounded-lg\">\n              <div className=\"flex items-center gap-2 mb-2\">\n                <Activity className=\"w-4 h-4 text-gray-400\" />\n                <span className=\"text-sm text-gray-500\">{t('pyth.publisher.stake')}</span>\n              </div>\n              <p className=\"text-2xl font-bold text-gray-900\">\n                {((publisher.stake ?? 0) / 1e6).toFixed(1)}M\n              </p>\n              <p className=\"text-xs text-gray-400 mt-1\">PYTH</p>\n            </div>\n\n            <div className=\"bg-gray-50 p-4 rounded-lg\">\n              <div className=\"flex items-center gap-2 mb-2\">\n                <TrendingUp className=\"w-4 h-4 text-gray-400\" />\n                <span className=\"text-sm text-gray-500\">{t('pyth.publisher.accuracy')}</span>\n              </div>\n              <p className=\"text-2xl font-bold text-emerald-600\