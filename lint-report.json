assName=\"px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n                {t('crossOracle.price')}\n              </th>\n              <th className=\"px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n                {t('crossOracle.stats.deviationFromAverage')}\n              </th>\n              <th className=\"px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n                {t('crossOracle.confidence')}\n              </th>\n              <th className=\"px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider\">\n                {t('crossOracleComparison.avgResponseTime')}\n              </th>\n            </tr>\n          </thead>\n          <tbody>\n            {deviationData\n              .sort((a, b) => b.deviationPercent - a.deviationPercent)\n              .map((data) => (\n                <tr key={data.provider} className=\"border-b border-gray-100 hover:bg-gray-50\">\n                  <td className=\"px-3 py-2 whitespace-nowrap\">\n                    <span\n                      className={`inline-flex items-center justify-center w-5 h-5 text-xs font-medium ${\n                        data.rank === 1\n                          ? 'bg-danger-100 text-danger-800'\n                          : data.rank === 2\n                            ? 'bg-warning-100 text-orange-800'\n                            : data.rank === 3\n                              ? 'bg-warning-100 text-yellow-800'\n                              : 'bg-gray-100 text-gray-600'\n                      }`}\n                    >\n                      {data.rank}\n                    </span>\n                  </td>\n                  <td className=\"px-3 py-2 whitespace-nowrap\">\n                    <div className=\"flex items-center\">\n                      <div className=\"w-2.5 h-2.5 mr-2\" style={{ backgroundColor: data.color }} />\n                      <span className=\"font-medium text-gray-900\">{data.name}</span>\n                    </div>\n                  </td>\n                  <td className=\"px-3 py-2 whitespace-nowrap text-gray-900 font-mono\">\n                    ${data.price.toFixed(2)}\n                  </td>\n                  <td\n                    className={`px-3 py-2 whitespace-nowrap font-mono ${\n                      data.deviationFromAvg > 0 ? 'text-success-600' : 'text-danger-600'\n                    }`}\n                  >\n                    {data.deviationFromAvg > 0 ? '+' : ''}\n                    {data.deviationFromAvg.toFixed(3)}%\n                  </td>\n                  <td className=\"px-3 py-2 whitespace-nowrap text-gray-500\">\n                    {data.confidence ? `${(data.confidence * 100).toFixed(1)}%` : '-'}\n                  </td>\n                  <td className=\"px-3 py-2 whitespace-nowrap text-gray-500\">\n                    {data.responseTime}ms\n                  </td>\n                </tr>\n              ))}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/components/oracle/charts/CrossOracleComparison/OverviewTab.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'chartColors' is defined but never used. Allowed unused vars must match /^_/u.","line":15,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":15,"endColumn":33,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"chartColors"},"fix":{"range":[220,233],"text":""},"desc":"Rem