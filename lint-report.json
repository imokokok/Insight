rts: import('@/lib/realtime/priceAlerts').PriceAlert[];\n  alertHistory: import('@/lib/realtime/priceAlerts').AlertHistory[];\n  addPriceAlert: (\n    alert: Omit<\n      import('@/lib/realtime/priceAlerts').PriceAlert,\n      'id' | 'createdAt' | 'triggeredCount'\n    >\n  ) => void;\n  removePriceAlert: (id: string) => void;\n  togglePriceAlert: (id: string) => void;\n  acknowledgeAlertHistory: (historyId: string) => void;\n  clearAlertHistory: () => void;\n  requestNotificationPermission: () => Promise<boolean>;\n  hasNotificationPermission: boolean;\n  triggeredAlerts: import('@/lib/realtime/priceAlerts').AlertCheckResult[];\n}\n","usedDeprecatedRules":[{"ruleId":"@typescript-eslint/no-empty-interface","replacedBy":["@typescript-eslint/no-empty-object-type"],"info":{"deprecatedSince":"8.0.0","replacedBy":[{"rule":{"name":"@typescript-eslint/no-empty-object-type","url":"https://typescript-eslint.io/rules/no-empty-object-type"}}],"url":"https://github.com/typescript-eslint/typescript-eslint/pull/8977"}}]},{"filePath":"/Users/imokokok/Documents/foresight-build/insight/src/app/[locale]/market-overview/useDataFetching.ts","messages":[{"ruleId":"max-lines-per-function","severity":2,"message":"Function 'useDataFetching' has too many lines (461). Maximum allowed is 50.","line":107,"column":8,"nodeType":"FunctionDeclaration","messageId":"exceed","endLine":567,"endColumn":2},{"ruleId":"max-lines-per-function","severity":2,"message":"Async arrow function has too many lines (89). Maximum allowed is 50.","line":164,"column":5,"nodeType":"ArrowFunctionExpression","messageId":"exceed","endLine":252,"endColumn":6},{"ruleId":"complexity","severity":2,"message":"Async arrow function has a complexity of 15. Maximum allowed is 10.","line":164,"column":43,"nodeType":"ArrowFunctionExpression","messageId":"complex","endLine":164,"endColumn":45},{"ruleId":"max-lines-per-function","severity":2,"message":"Async arrow function has too many lines (65). Maximum allowed is 50.","line":257,"c